<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_controls_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <View
        android:id="@+id/viewThemeSwatch"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_hud_overlay" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtThemeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KMPlayer Carbon"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtThemeCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Classic Archetype"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtThemeAccentCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="#E67E22"
        android:textColor="@color/accent"
        android:textSize="11sp" />
</LinearLayout>
