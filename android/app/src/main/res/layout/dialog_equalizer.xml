<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Audio DSP &amp; Parametric Equalizer"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/switchEqualizerEnable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <!-- Preset Selector Spinner -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Sound Presets"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spinnerPresets"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_controls_pill" />

    <!-- Sliders Container -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:id="@+id/layoutEqBands"
            android:layout_width="wrap_content"
            android:layout_height="220dp"
            android:gravity="center"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Bass Boost & Virtualizer 3D Surround Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtBassBoostLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bass Boost: 0%"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/seekBarBassBoost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progress="0"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <TextView
            android:id="@+id/txtVirtualizerLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="3D Spatial Virtualizer: 0%"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/seekBarVirtualizer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progress="0"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />
    </LinearLayout>

    <Button
        android:id="@+id/btnResetEqualizer"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:text="Reset to Flat"
        android:textColor="@color/text_primary" />
</LinearLayout>
