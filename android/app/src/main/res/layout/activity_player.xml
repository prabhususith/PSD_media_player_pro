<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_dark"
    android:keepScreenOn="true">

    <!-- Zero-Copy Hardware Accelerated Surface Video View -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/mediaPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="surface_view"
        app:resize_mode="fit" />

    <!-- Subtitle Overlay Layer -->
    <com.psdtechnologies.psdplayer.ui.views.SubtitleTextView
        android:id="@+id/subtitleOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="72dp"
        android:padding="8dp"
        android:visibility="gone" />

    <!-- Multi-Touch Gesture Detection Layer -->
    <com.psdtechnologies.psdplayer.ui.views.GestureOverlayView
        android:id="@+id/gestureOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Gesture Floating HUD Indicator (Brightness, Volume, Seek) -->
    <LinearLayout
        android:id="@+id/gestureHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_hud_overlay"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtHudTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volume"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressHud"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="140dp"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="50"
            android:progressTint="@color/accent" />

        <TextView
            android:id="@+id/txtHudValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="50%"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Overlay Controls Layer -->
    <include
        android:id="@+id/controlsOverlay"
        layout="@layout/view_player_controls" />

</FrameLayout>
