<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutControlsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/controls_overlay">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:background="#66000000">

        <TextView
            android:id="@+id/txtMediaTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtCodecBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_controls_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="1080p | MediaCodec"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:layout_marginEnd="8dp" />

        <!-- Aspect Ratio Button -->
        <ImageButton
            android:id="@+id/btnAspectRatio"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/aspect_ratio"
            android:src="@drawable/ic_aspect_ratio" />

        <!-- Theme Selector Button -->
        <ImageButton
            android:id="@+id/btnThemeSelector"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/themes"
            android:src="@drawable/ic_palette" />

        <!-- Picture in Picture Button -->
        <ImageButton
            android:id="@+id/btnPip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/pip_mode"
            android:src="@drawable/ic_pip" />

        <!-- Pin Controls Toggle Button -->
        <ImageButton
            android:id="@+id/btnPinControls"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/pin_controls"
            android:src="@drawable/ic_pin" />
    </LinearLayout>

    <!-- Center Transport Controls -->
    <LinearLayout
        android:id="@+id/centerTransport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnRewind"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_controls_pill"
            android:contentDescription="@string/rewind_10s"
            android:src="@drawable/ic_replay_10" />

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginHorizontal="32dp"
            android:background="@drawable/bg_controls_pill"
            android:contentDescription="@string/play"
            android:src="@drawable/ic_pause" />

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_controls_pill"
            android:contentDescription="@string/forward_10s"
            android:src="@drawable/ic_forward_10" />
    </LinearLayout>

    <!-- Bottom Controls & Scrub Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#80000000"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- Timeline Scrub Bar Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:fontFamily="monospace" />

            <SeekBar
                android:id="@+id/seekBarTimeline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000"
                android:progress="0"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <TextView
                android:id="@+id/txtTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Action Pills Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEqualizer"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/equalizer"
                android:textColor="@color/accent"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnTools"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/tools"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnBackgroundPlay"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/background_play"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
