<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Industrial Hazard (High-Contrast &amp; Gamer Skins) -->
    <sys:String x:Key="ThemeId">hazard-yellow-stripes</sys:String>
    <sys:String x:Key="ThemeName">Industrial Hazard</sys:String>
    <sys:String x:Key="ThemeCategory">High-Contrast &amp; Gamer Skins</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#0A0A0A" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#141414" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#0A0A0A" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#FFCC00" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#FFCC00" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#141414" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#FFCC00" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#141414" />
</ResourceDictionary>