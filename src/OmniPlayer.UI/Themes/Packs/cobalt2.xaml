<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Cobalt2 (Modern Flat &amp; Fluent) -->
    <sys:String x:Key="ThemeId">cobalt2</sys:String>
    <sys:String x:Key="ThemeName">Cobalt2</sys:String>
    <sys:String x:Key="ThemeCategory">Modern Flat &amp; Fluent</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#193549" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#1F4662" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#193549" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#FFC600" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#FFC600" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#1F4662" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#FFC600" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#1F4662" />
</ResourceDictionary>