<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Synthwave '84 Flat (Modern Flat &amp; Fluent) -->
    <sys:String x:Key="ThemeId">synthwave-84-flat</sys:String>
    <sys:String x:Key="ThemeName">Synthwave '84 Flat</sys:String>
    <sys:String x:Key="ThemeCategory">Modern Flat &amp; Fluent</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#262335" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#342E48" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#262335" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#FF7EDB" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#FF7EDB" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FDFDFD" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#342E48" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#FF7EDB" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#342E48" />
</ResourceDictionary>