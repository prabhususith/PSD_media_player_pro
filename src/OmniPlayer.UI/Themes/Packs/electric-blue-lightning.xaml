<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Electric Blue Lightning (High-Contrast &amp; Gamer Skins) -->
    <sys:String x:Key="ThemeId">electric-blue-lightning</sys:String>
    <sys:String x:Key="ThemeName">Electric Blue Lightning</sys:String>
    <sys:String x:Key="ThemeCategory">High-Contrast &amp; Gamer Skins</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#020712" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#05112B" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#020712" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#00D4FF" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#00D4FF" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#F0FBFF" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#05112B" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#00D4FF" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#05112B" />
</ResourceDictionary>