<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Vesper Minimal (Modern Flat &amp; Fluent) -->
    <sys:String x:Key="ThemeId">vesper-minimal</sys:String>
    <sys:String x:Key="ThemeName">Vesper Minimal</sys:String>
    <sys:String x:Key="ThemeCategory">Modern Flat &amp; Fluent</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#101010" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#181818" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#101010" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#FFC799" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#FFC799" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#181818" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#FFC799" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#181818" />
</ResourceDictionary>