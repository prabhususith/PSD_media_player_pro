<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: PotPlayer Black (Classic Player Archetypes) -->
    <sys:String x:Key="ThemeId">potplayer-black</sys:String>
    <sys:String x:Key="ThemeName">PotPlayer Black</sys:String>
    <sys:String x:Key="ThemeCategory">Classic Player Archetypes</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#0C0C0D" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#161618" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#0C0C0D" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#E53E3E" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#E53E3E" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#F7FAFC" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#161618" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#E53E3E" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#161618" />
</ResourceDictionary>