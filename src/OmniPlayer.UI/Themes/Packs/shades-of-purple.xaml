<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Shades of Purple (Modern Flat &amp; Fluent) -->
    <sys:String x:Key="ThemeId">shades-of-purple</sys:String>
    <sys:String x:Key="ThemeName">Shades of Purple</sys:String>
    <sys:String x:Key="ThemeCategory">Modern Flat &amp; Fluent</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#222244" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#2D2B55" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#222244" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#FAD000" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#FAD000" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#2D2B55" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#FAD000" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#2D2B55" />
</ResourceDictionary>