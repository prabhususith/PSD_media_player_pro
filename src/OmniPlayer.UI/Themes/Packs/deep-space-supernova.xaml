<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Deep Space Supernova (High-Contrast &amp; Gamer Skins) -->
    <sys:String x:Key="ThemeId">deep-space-supernova</sys:String>
    <sys:String x:Key="ThemeName">Deep Space Supernova</sys:String>
    <sys:String x:Key="ThemeCategory">High-Contrast &amp; Gamer Skins</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#0A0514" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#160C2B" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#0A0514" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#7928CA" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#7928CA" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FAF5FF" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#160C2B" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#7928CA" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#160C2B" />
</ResourceDictionary>