<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Pure White Minimal (Modern Flat &amp; Fluent) -->
    <sys:String x:Key="ThemeId">pure-white</sys:String>
    <sys:String x:Key="ThemeName">Pure White Minimal</sys:String>
    <sys:String x:Key="ThemeCategory">Modern Flat &amp; Fluent</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#FFFFFF" />
</ResourceDictionary>