<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Phantom Velvet Glass (Studio Glass &amp; Acrylic) -->
    <sys:String x:Key="ThemeId">phantom-velvet-glass</sys:String>
    <sys:String x:Key="ThemeName">Phantom Velvet Glass</sys:String>
    <sys:String x:Key="ThemeCategory">Studio Glass &amp; Acrylic</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#120F17" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#1D1826" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#120F17" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#9333EA" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#9333EA" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FAF5FF" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#1D1826" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#9333EA" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#1D1826" />
</ResourceDictionary>