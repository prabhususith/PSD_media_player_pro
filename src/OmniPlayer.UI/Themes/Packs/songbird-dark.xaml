<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Songbird Dusk (Classic Player Archetypes) -->
    <sys:String x:Key="ThemeId">songbird-dark</sys:String>
    <sys:String x:Key="ThemeName">Songbird Dusk</sys:String>
    <sys:String x:Key="ThemeCategory">Classic Player Archetypes</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#16121C" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#231C2D" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#16121C" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#A855F7" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#A855F7" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FAF5FF" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#231C2D" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#A855F7" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#231C2D" />
</ResourceDictionary>