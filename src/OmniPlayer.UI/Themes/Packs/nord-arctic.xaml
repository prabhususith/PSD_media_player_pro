<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Nord Arctic (Modern Flat &amp; Fluent) -->
    <sys:String x:Key="ThemeId">nord-arctic</sys:String>
    <sys:String x:Key="ThemeName">Nord Arctic</sys:String>
    <sys:String x:Key="ThemeCategory">Modern Flat &amp; Fluent</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#2E3440" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#3B4252" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#2E3440" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#88C0D0" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#88C0D0" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#ECEFF4" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#3B4252" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#88C0D0" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#3B4252" />
</ResourceDictionary>