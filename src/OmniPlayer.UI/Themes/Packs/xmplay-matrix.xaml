<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: XMPlay Matrix (Classic Player Archetypes) -->
    <sys:String x:Key="ThemeId">xmplay-matrix</sys:String>
    <sys:String x:Key="ThemeName">XMPlay Matrix</sys:String>
    <sys:String x:Key="ThemeCategory">Classic Player Archetypes</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#08100A" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#0F1E13" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#08100A" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#DCFCE7" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#0F1E13" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#0F1E13" />
</ResourceDictionary>