<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: RealPlayer Neo Cyan (Classic Player Archetypes) -->
    <sys:String x:Key="ThemeId">realplayer-neo-cyan</sys:String>
    <sys:String x:Key="ThemeName">RealPlayer Neo Cyan</sys:String>
    <sys:String x:Key="ThemeCategory">Classic Player Archetypes</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#0E171E" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#16232D" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#0E171E" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#14B8A6" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#14B8A6" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#F0FDFA" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#16232D" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#14B8A6" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#16232D" />
</ResourceDictionary>