<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Night Owl (Modern Flat &amp; Fluent) -->
    <sys:String x:Key="ThemeId">night-owl</sys:String>
    <sys:String x:Key="ThemeName">Night Owl</sys:String>
    <sys:String x:Key="ThemeCategory">Modern Flat &amp; Fluent</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#011627" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#0B253A" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#011627" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#82AAFF" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#82AAFF" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#D6DEEB" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#0B253A" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#82AAFF" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#0B253A" />
</ResourceDictionary>