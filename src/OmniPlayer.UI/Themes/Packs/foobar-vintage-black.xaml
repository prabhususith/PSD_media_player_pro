<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Foobar Vintage (Classic Player Archetypes) -->
    <sys:String x:Key="ThemeId">foobar-vintage-black</sys:String>
    <sys:String x:Key="ThemeName">Foobar Vintage</sys:String>
    <sys:String x:Key="ThemeCategory">Classic Player Archetypes</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#121212" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#121212" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#1C1C1C" />
</ResourceDictionary>