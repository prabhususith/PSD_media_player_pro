<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Solarized Light (Modern Flat &amp; Fluent) -->
    <sys:String x:Key="ThemeId">solarized-light</sys:String>
    <sys:String x:Key="ThemeName">Solarized Light</sys:String>
    <sys:String x:Key="ThemeCategory">Modern Flat &amp; Fluent</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#FDF6E3" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#EEE8D5" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#FDF6E3" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#268BD2" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#268BD2" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#657B83" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#EEE8D5" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#268BD2" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#EEE8D5" />
</ResourceDictionary>