<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: iTunes Retro Dark (Classic Player Archetypes) -->
    <sys:String x:Key="ThemeId">itunes-retro-dark</sys:String>
    <sys:String x:Key="ThemeName">iTunes Retro Dark</sys:String>
    <sys:String x:Key="ThemeCategory">Classic Player Archetypes</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#262626" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#EC4899" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#EC4899" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FDF2F8" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#262626" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#EC4899" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#262626" />
</ResourceDictionary>