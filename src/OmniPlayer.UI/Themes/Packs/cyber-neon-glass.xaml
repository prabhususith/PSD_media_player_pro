<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Cyberpunk Neon Glass (Studio Glass &amp; Acrylic) -->
    <sys:String x:Key="ThemeId">cyber-neon-glass</sys:String>
    <sys:String x:Key="ThemeName">Cyberpunk Neon Glass</sys:String>
    <sys:String x:Key="ThemeCategory">Studio Glass &amp; Acrylic</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#110D1A" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#1C152B" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#110D1A" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#F43F5E" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#F43F5E" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FFF1F2" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#1C152B" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#F43F5E" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#1C152B" />
</ResourceDictionary>