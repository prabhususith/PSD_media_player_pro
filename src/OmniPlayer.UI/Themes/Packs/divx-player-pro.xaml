<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: DivX Player Pro (Classic Player Archetypes) -->
    <sys:String x:Key="ThemeId">divx-player-pro</sys:String>
    <sys:String x:Key="ThemeName">DivX Player Pro</sys:String>
    <sys:String x:Key="ThemeCategory">Classic Player Archetypes</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#0C131F" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#142033" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#0C131F" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#F0F9FF" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#142033" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#142033" />
</ResourceDictionary>