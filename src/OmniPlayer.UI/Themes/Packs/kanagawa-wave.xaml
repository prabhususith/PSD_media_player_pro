<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Kanagawa Wave (Modern Flat &amp; Fluent) -->
    <sys:String x:Key="ThemeId">kanagawa-wave</sys:String>
    <sys:String x:Key="ThemeName">Kanagawa Wave</sys:String>
    <sys:String x:Key="ThemeCategory">Modern Flat &amp; Fluent</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#1F1F28" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#2A2A37" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#1F1F28" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#7E9CD8" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#7E9CD8" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#DCD7BA" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#2A2A37" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#7E9CD8" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#2A2A37" />
</ResourceDictionary>