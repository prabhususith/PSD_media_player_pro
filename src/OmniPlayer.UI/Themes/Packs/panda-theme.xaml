<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Panda Dark (Modern Flat &amp; Fluent) -->
    <sys:String x:Key="ThemeId">panda-theme</sys:String>
    <sys:String x:Key="ThemeName">Panda Dark</sys:String>
    <sys:String x:Key="ThemeCategory">Modern Flat &amp; Fluent</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#292A2B" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#303133" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#292A2B" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#19F9D8" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#19F9D8" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#E6E6E6" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#303133" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#19F9D8" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#303133" />
</ResourceDictionary>