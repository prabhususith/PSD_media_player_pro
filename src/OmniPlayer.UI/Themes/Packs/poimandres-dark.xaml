<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Poimandres (Modern Flat &amp; Fluent) -->
    <sys:String x:Key="ThemeId">poimandres-dark</sys:String>
    <sys:String x:Key="ThemeName">Poimandres</sys:String>
    <sys:String x:Key="ThemeCategory">Modern Flat &amp; Fluent</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#1B1E2B" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#252B3B" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#1B1E2B" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#5DE4C7" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#5DE4C7" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#E4F0FB" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#252B3B" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#5DE4C7" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#252B3B" />
</ResourceDictionary>