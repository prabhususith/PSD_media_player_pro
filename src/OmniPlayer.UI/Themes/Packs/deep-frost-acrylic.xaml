<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Deep Frost Acrylic (Studio Glass &amp; Acrylic) -->
    <sys:String x:Key="ThemeId">deep-frost-acrylic</sys:String>
    <sys:String x:Key="ThemeName">Deep Frost Acrylic</sys:String>
    <sys:String x:Key="ThemeCategory">Studio Glass &amp; Acrylic</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#0C1420" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#142133" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#0C1420" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#F0F9FF" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#142133" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#142133" />
</ResourceDictionary>