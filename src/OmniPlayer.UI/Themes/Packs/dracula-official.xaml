<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Dracula Official (Modern Flat &amp; Fluent) -->
    <sys:String x:Key="ThemeId">dracula-official</sys:String>
    <sys:String x:Key="ThemeName">Dracula Official</sys:String>
    <sys:String x:Key="ThemeCategory">Modern Flat &amp; Fluent</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#282A36" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#343746" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#282A36" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#BD93F9" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#BD93F9" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#F8F8F2" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#343746" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#BD93F9" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#343746" />
</ResourceDictionary>