<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Matrix Emerald (High-Contrast &amp; Gamer Skins) -->
    <sys:String x:Key="ThemeId">matrix-emerald-terminal</sys:String>
    <sys:String x:Key="ThemeName">Matrix Emerald</sys:String>
    <sys:String x:Key="ThemeCategory">High-Contrast &amp; Gamer Skins</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#000501" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#001405" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#000501" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#00FF41" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#00FF41" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#00FF41" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#001405" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#00FF41" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#001405" />
</ResourceDictionary>