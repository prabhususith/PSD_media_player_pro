<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: VLC Modern Orange (Classic Player Archetypes) -->
    <sys:String x:Key="ThemeId">vlc-modern-orange</sys:String>
    <sys:String x:Key="ThemeName">VLC Modern Orange</sys:String>
    <sys:String x:Key="ThemeCategory">Classic Player Archetypes</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#18181B" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#27272A" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#18181B" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#F97316" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#F97316" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#27272A" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#F97316" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#27272A" />
</ResourceDictionary>