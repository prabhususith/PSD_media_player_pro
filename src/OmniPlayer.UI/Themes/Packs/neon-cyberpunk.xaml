<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Neon Cyberpunk (High-Contrast &amp; Gamer Skins) -->
    <sys:String x:Key="ThemeId">neon-cyberpunk</sys:String>
    <sys:String x:Key="ThemeName">Neon Cyberpunk</sys:String>
    <sys:String x:Key="ThemeCategory">High-Contrast &amp; Gamer Skins</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#08060D" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#140F22" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#08060D" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#FFE600" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#FFE600" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#00F0FF" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#140F22" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#FFE600" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#140F22" />
</ResourceDictionary>