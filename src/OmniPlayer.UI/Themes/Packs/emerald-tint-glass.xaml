<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Emerald Tint (Studio Glass &amp; Acrylic) -->
    <sys:String x:Key="ThemeId">emerald-tint-glass</sys:String>
    <sys:String x:Key="ThemeName">Emerald Tint</sys:String>
    <sys:String x:Key="ThemeCategory">Studio Glass &amp; Acrylic</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#0B1711" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#12251B" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#0B1711" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#10B981" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#10B981" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#ECFDF5" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#12251B" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#10B981" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#12251B" />
</ResourceDictionary>