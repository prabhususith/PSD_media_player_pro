<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Arctic Blue Glass (Studio Glass &amp; Acrylic) -->
    <sys:String x:Key="ThemeId">arctic-blue-glass</sys:String>
    <sys:String x:Key="ThemeName">Arctic Blue Glass</sys:String>
    <sys:String x:Key="ThemeCategory">Studio Glass &amp; Acrylic</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#0C1724" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#132438" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#0C1724" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#00D2FF" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#00D2FF" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#F0F9FF" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#132438" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#00D2FF" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#132438" />
</ResourceDictionary>