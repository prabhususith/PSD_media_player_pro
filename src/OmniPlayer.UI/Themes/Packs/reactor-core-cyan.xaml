<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Cherenkov Reactor Core (High-Contrast &amp; Gamer Skins) -->
    <sys:String x:Key="ThemeId">reactor-core-cyan</sys:String>
    <sys:String x:Key="ThemeName">Cherenkov Reactor Core</sys:String>
    <sys:String x:Key="ThemeCategory">High-Contrast &amp; Gamer Skins</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#010A14" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#03152B" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#010A14" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#00B4D8" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#00B4D8" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#CAF0F8" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#03152B" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#00B4D8" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#03152B" />
</ResourceDictionary>