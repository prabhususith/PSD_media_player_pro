<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Solarized Dark (Modern Flat &amp; Fluent) -->
    <sys:String x:Key="ThemeId">solarized-dark</sys:String>
    <sys:String x:Key="ThemeName">Solarized Dark</sys:String>
    <sys:String x:Key="ThemeCategory">Modern Flat &amp; Fluent</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#002B36" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#073642" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#002B36" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#2AA198" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#2AA198" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#839496" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#073642" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#2AA198" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#073642" />
</ResourceDictionary>