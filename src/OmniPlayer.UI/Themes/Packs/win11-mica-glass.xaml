<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Windows 11 Mica Glass (Studio Glass &amp; Acrylic) -->
    <sys:String x:Key="ThemeId">win11-mica-glass</sys:String>
    <sys:String x:Key="ThemeName">Windows 11 Mica Glass</sys:String>
    <sys:String x:Key="ThemeCategory">Studio Glass &amp; Acrylic</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#18181C" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#202026" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#18181C" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#202026" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#202026" />
</ResourceDictionary>