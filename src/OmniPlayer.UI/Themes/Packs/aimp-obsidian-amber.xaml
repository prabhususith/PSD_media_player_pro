<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: AIMP Obsidian (Classic Player Archetypes) -->
    <sys:String x:Key="ThemeId">aimp-obsidian-amber</sys:String>
    <sys:String x:Key="ThemeName">AIMP Obsidian</sys:String>
    <sys:String x:Key="ThemeCategory">Classic Player Archetypes</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#131416" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#1C1E22" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#131416" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#D97706" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#D97706" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FFFBEB" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#1C1E22" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#D97706" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#1C1E22" />
</ResourceDictionary>