<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Windows Media Player 11 Onyx (Classic Player Archetypes) -->
    <sys:String x:Key="ThemeId">wmp11-onyx</sys:String>
    <sys:String x:Key="ThemeName">Windows Media Player 11 Onyx</sys:String>
    <sys:String x:Key="ThemeCategory">Classic Player Archetypes</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#0F1115" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#181C22" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#0F1115" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#00D2FF" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#00D2FF" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#181C22" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#00D2FF" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#181C22" />
</ResourceDictionary>