<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Golden Aegis (High-Contrast &amp; Gamer Skins) -->
    <sys:String x:Key="ThemeId">golden-aegis</sys:String>
    <sys:String x:Key="ThemeName">Golden Aegis</sys:String>
    <sys:String x:Key="ThemeCategory">High-Contrast &amp; Gamer Skins</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#0F0D06" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#1F1B0D" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#0F0D06" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#FFD700" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#FFD700" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FFFDF0" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#1F1B0D" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#FFD700" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#1F1B0D" />
</ResourceDictionary>