<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Palenight (Modern Flat &amp; Fluent) -->
    <sys:String x:Key="ThemeId">palenight</sys:String>
    <sys:String x:Key="ThemeName">Palenight</sys:String>
    <sys:String x:Key="ThemeCategory">Modern Flat &amp; Fluent</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#292D3E" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#343A50" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#292D3E" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#C792EA" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#C792EA" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#ECEFF1" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#343A50" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#C792EA" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#343A50" />
</ResourceDictionary>