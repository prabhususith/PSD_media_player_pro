<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Audacious Classic (Classic Player Archetypes) -->
    <sys:String x:Key="ThemeId">audacious-classic</sys:String>
    <sys:String x:Key="ThemeName">Audacious Classic</sys:String>
    <sys:String x:Key="ThemeCategory">Classic Player Archetypes</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#282828" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#282828" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#282828" />
</ResourceDictionary>