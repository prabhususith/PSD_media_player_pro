<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Glacial White Glass (Studio Glass &amp; Acrylic) -->
    <sys:String x:Key="ThemeId">glacial-white-glass</sys:String>
    <sys:String x:Key="ThemeName">Glacial White Glass</sys:String>
    <sys:String x:Key="ThemeCategory">Studio Glass &amp; Acrylic</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#EBF4F6" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#F5FAFA" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#EBF4F6" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#F5FAFA" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#F5FAFA" />
</ResourceDictionary>