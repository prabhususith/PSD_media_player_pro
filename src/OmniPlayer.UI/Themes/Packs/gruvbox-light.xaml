<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Gruvbox Light (Modern Flat &amp; Fluent) -->
    <sys:String x:Key="ThemeId">gruvbox-light</sys:String>
    <sys:String x:Key="ThemeName">Gruvbox Light</sys:String>
    <sys:String x:Key="ThemeCategory">Modern Flat &amp; Fluent</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#FBF1C7" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#EBDBB2" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#FBF1C7" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#AF3A03" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#AF3A03" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#3C3836" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#EBDBB2" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#AF3A03" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#EBDBB2" />
</ResourceDictionary>