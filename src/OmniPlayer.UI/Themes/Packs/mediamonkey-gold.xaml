<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: MediaMonkey Gold (Classic Player Archetypes) -->
    <sys:String x:Key="ThemeId">mediamonkey-gold</sys:String>
    <sys:String x:Key="ThemeName">MediaMonkey Gold</sys:String>
    <sys:String x:Key="ThemeCategory">Classic Player Archetypes</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#141210" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#1F1C18" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#141210" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#EAB308" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#EAB308" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FEF9C3" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#1F1C18" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#EAB308" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#1F1C18" />
</ResourceDictionary>