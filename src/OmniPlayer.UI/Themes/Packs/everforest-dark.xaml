<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Everforest Dark (Modern Flat &amp; Fluent) -->
    <sys:String x:Key="ThemeId">everforest-dark</sys:String>
    <sys:String x:Key="ThemeName">Everforest Dark</sys:String>
    <sys:String x:Key="ThemeCategory">Modern Flat &amp; Fluent</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#2D353B" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#343F44" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#2D353B" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#A7C080" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#A7C080" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#D3C6AA" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#343F44" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#A7C080" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#343F44" />
</ResourceDictionary>