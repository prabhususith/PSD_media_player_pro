<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Winamp Classic Gold (Classic Player Archetypes) -->
    <sys:String x:Key="ThemeId">winamp-classic-gold</sys:String>
    <sys:String x:Key="ThemeName">Winamp Classic Gold</sys:String>
    <sys:String x:Key="ThemeCategory">Classic Player Archetypes</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#0F1210" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#1A1F1B" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#0F1210" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#10B981" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#10B981" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#E6FFFA" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#1A1F1B" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#10B981" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#1A1F1B" />
</ResourceDictionary>