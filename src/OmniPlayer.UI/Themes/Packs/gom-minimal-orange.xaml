<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: GOM Minimal (Classic Player Archetypes) -->
    <sys:String x:Key="ThemeId">gom-minimal-orange</sys:String>
    <sys:String x:Key="ThemeName">GOM Minimal</sys:String>
    <sys:String x:Key="ThemeCategory">Classic Player Archetypes</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#17181A" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#222428" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#17181A" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#FF8C00" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#FF8C00" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#ECEFF4" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#222428" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#FF8C00" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#222428" />
</ResourceDictionary>