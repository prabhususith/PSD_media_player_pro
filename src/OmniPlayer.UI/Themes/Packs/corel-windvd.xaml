<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Corel WinDVD Cinema (Classic Player Archetypes) -->
    <sys:String x:Key="ThemeId">corel-windvd</sys:String>
    <sys:String x:Key="ThemeName">Corel WinDVD Cinema</sys:String>
    <sys:String x:Key="ThemeCategory">Classic Player Archetypes</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#180F12" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#26171C" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#180F12" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#E11D48" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#E11D48" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FFF1F2" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#26171C" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#E11D48" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#26171C" />
</ResourceDictionary>