<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Frosted Sapphire (Studio Glass &amp; Acrylic) -->
    <sys:String x:Key="ThemeId">frosted-sapphire</sys:String>
    <sys:String x:Key="ThemeName">Frosted Sapphire</sys:String>
    <sys:String x:Key="ThemeCategory">Studio Glass &amp; Acrylic</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#0A1026" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#111B3D" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#0A1026" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#6366F1" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#6366F1" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#EEF2FF" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#111B3D" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#6366F1" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#111B3D" />
</ResourceDictionary>