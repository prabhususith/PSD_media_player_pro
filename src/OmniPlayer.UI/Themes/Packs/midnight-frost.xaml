<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Midnight Frost (Studio Glass &amp; Acrylic) -->
    <sys:String x:Key="ThemeId">midnight-frost</sys:String>
    <sys:String x:Key="ThemeName">Midnight Frost</sys:String>
    <sys:String x:Key="ThemeCategory">Studio Glass &amp; Acrylic</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#080B12" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#101624" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#080B12" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#101624" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#101624" />
</ResourceDictionary>