<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Rose Quartz Glass (Studio Glass &amp; Acrylic) -->
    <sys:String x:Key="ThemeId">rose-quartz-glass</sys:String>
    <sys:String x:Key="ThemeName">Rose Quartz Glass</sys:String>
    <sys:String x:Key="ThemeCategory">Studio Glass &amp; Acrylic</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#1C1115" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#2B1A20" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#1C1115" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#F472B6" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#F472B6" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FDF2F8" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#2B1A20" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#F472B6" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#2B1A20" />
</ResourceDictionary>