<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: ZoomPlayer Graphite (Classic Player Archetypes) -->
    <sys:String x:Key="ThemeId">zoomplayer-graphite</sys:String>
    <sys:String x:Key="ThemeName">ZoomPlayer Graphite</sys:String>
    <sys:String x:Key="ThemeCategory">Classic Player Archetypes</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#181A1D" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#22252A" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#181A1D" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#EA580C" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#EA580C" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FFF7ED" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#22252A" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#EA580C" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#22252A" />
</ResourceDictionary>