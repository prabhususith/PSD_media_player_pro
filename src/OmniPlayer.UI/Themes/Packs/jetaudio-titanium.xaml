<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: JetAudio Titanium (Classic Player Archetypes) -->
    <sys:String x:Key="ThemeId">jetaudio-titanium</sys:String>
    <sys:String x:Key="ThemeName">JetAudio Titanium</sys:String>
    <sys:String x:Key="ThemeCategory">Classic Player Archetypes</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#1B1D20" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#24272C" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#1B1D20" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#06B6D4" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#06B6D4" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#24272C" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#06B6D4" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#24272C" />
</ResourceDictionary>