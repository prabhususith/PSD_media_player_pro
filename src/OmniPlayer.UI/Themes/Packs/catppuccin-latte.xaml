<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Catppuccin Latte (Modern Flat &amp; Fluent) -->
    <sys:String x:Key="ThemeId">catppuccin-latte</sys:String>
    <sys:String x:Key="ThemeName">Catppuccin Latte</sys:String>
    <sys:String x:Key="ThemeCategory">Modern Flat &amp; Fluent</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#EFF1F5" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#CCD0DA" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#EFF1F5" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#8839EF" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#8839EF" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#4C4F69" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#CCD0DA" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#8839EF" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#CCD0DA" />
</ResourceDictionary>