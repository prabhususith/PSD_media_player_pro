<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Sunset Tint (Studio Glass &amp; Acrylic) -->
    <sys:String x:Key="ThemeId">sunset-tint-glass</sys:String>
    <sys:String x:Key="ThemeName">Sunset Tint</sys:String>
    <sys:String x:Key="ThemeCategory">Studio Glass &amp; Acrylic</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#1C1214" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#2B1B1E" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#1C1214" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#FB923C" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#FB923C" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FFF7ED" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#2B1B1E" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#FB923C" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#2B1B1E" />
</ResourceDictionary>