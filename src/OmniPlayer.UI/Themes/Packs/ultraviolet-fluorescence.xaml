<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Ultraviolet Blacklight (High-Contrast &amp; Gamer Skins) -->
    <sys:String x:Key="ThemeId">ultraviolet-fluorescence</sys:String>
    <sys:String x:Key="ThemeName">Ultraviolet Blacklight</sys:String>
    <sys:String x:Key="ThemeCategory">High-Contrast &amp; Gamer Skins</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#0A0012" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#170129" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#0A0012" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#E000FF" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#E000FF" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#F8F0FF" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#170129" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#E000FF" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#170129" />
</ResourceDictionary>