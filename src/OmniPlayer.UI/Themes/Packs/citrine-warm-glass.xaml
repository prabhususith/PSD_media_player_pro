<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Citrine Warm Glass (Studio Glass &amp; Acrylic) -->
    <sys:String x:Key="ThemeId">citrine-warm-glass</sys:String>
    <sys:String x:Key="ThemeName">Citrine Warm Glass</sys:String>
    <sys:String x:Key="ThemeCategory">Studio Glass &amp; Acrylic</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#1A170F" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#282317" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#1A170F" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#EAB308" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#EAB308" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FEFCE8" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#282317" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#EAB308" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#282317" />
</ResourceDictionary>