<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Magma Inferno (High-Contrast &amp; Gamer Skins) -->
    <sys:String x:Key="ThemeId">magma-inferno</sys:String>
    <sys:String x:Key="ThemeName">Magma Inferno</sys:String>
    <sys:String x:Key="ThemeCategory">High-Contrast &amp; Gamer Skins</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#120300" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#240700" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#120300" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#FF3700" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#FF3700" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FFF2F0" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#240700" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#FF3700" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#240700" />
</ResourceDictionary>