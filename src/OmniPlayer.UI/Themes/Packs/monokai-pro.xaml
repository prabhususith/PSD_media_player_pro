<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Monokai Pro (Modern Flat &amp; Fluent) -->
    <sys:String x:Key="ThemeId">monokai-pro</sys:String>
    <sys:String x:Key="ThemeName">Monokai Pro</sys:String>
    <sys:String x:Key="ThemeCategory">Modern Flat &amp; Fluent</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#2D2A2E" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#3A363B" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#2D2A2E" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#FFD866" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#FFD866" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FCFCFA" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#3A363B" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#FFD866" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#3A363B" />
</ResourceDictionary>