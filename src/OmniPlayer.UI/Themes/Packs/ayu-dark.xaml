<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Ayu Dark (Modern Flat &amp; Fluent) -->
    <sys:String x:Key="ThemeId">ayu-dark</sys:String>
    <sys:String x:Key="ThemeName">Ayu Dark</sys:String>
    <sys:String x:Key="ThemeCategory">Modern Flat &amp; Fluent</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#0B0E14" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#131721" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#0B0E14" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#E6B450" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#E6B450" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#BFBDB6" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#131721" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#E6B450" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#131721" />
</ResourceDictionary>