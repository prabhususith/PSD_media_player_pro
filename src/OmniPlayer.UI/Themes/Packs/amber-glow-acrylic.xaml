<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Amber Glow (Studio Glass &amp; Acrylic) -->
    <sys:String x:Key="ThemeId">amber-glow-acrylic</sys:String>
    <sys:String x:Key="ThemeName">Amber Glow</sys:String>
    <sys:String x:Key="ThemeCategory">Studio Glass &amp; Acrylic</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#1A150A" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#292110" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#1A150A" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FFFBEB" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#292110" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#292110" />
</ResourceDictionary>