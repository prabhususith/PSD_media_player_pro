<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Glitch Art RGB (High-Contrast &amp; Gamer Skins) -->
    <sys:String x:Key="ThemeId">glitch-blue-rgb</sys:String>
    <sys:String x:Key="ThemeName">Glitch Art RGB</sys:String>
    <sys:String x:Key="ThemeCategory">High-Contrast &amp; Gamer Skins</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#020612" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#050F29" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#020612" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#0066FF" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#0066FF" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#F0F5FF" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#050F29" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#0066FF" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#050F29" />
</ResourceDictionary>