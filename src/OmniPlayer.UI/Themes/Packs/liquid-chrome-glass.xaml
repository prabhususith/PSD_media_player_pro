<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Liquid Chrome Glass (Studio Glass &amp; Acrylic) -->
    <sys:String x:Key="ThemeId">liquid-chrome-glass</sys:String>
    <sys:String x:Key="ThemeName">Liquid Chrome Glass</sys:String>
    <sys:String x:Key="ThemeCategory">Studio Glass &amp; Acrylic</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#17181A" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#232529" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#17181A" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#232529" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#232529" />
</ResourceDictionary>