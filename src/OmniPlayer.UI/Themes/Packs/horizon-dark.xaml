<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Horizon Dark (Modern Flat &amp; Fluent) -->
    <sys:String x:Key="ThemeId">horizon-dark</sys:String>
    <sys:String x:Key="ThemeName">Horizon Dark</sys:String>
    <sys:String x:Key="ThemeCategory">Modern Flat &amp; Fluent</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#1C1E26" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#232530" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#1C1E26" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#E95678" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#E95678" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#D5D8DA" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#232530" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#E95678" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#232530" />
</ResourceDictionary>