<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: WMP 12 Aero Glass (Classic Player Archetypes) -->
    <sys:String x:Key="ThemeId">wmp12-aero</sys:String>
    <sys:String x:Key="ThemeName">WMP 12 Aero Glass</sys:String>
    <sys:String x:Key="ThemeCategory">Classic Player Archetypes</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#1A222C" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#24303E" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#1A222C" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#24303E" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#24303E" />
</ResourceDictionary>