<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: Clementine Dusk (Classic Player Archetypes) -->
    <sys:String x:Key="ThemeId">clementine-dusk</sys:String>
    <sys:String x:Key="ThemeName">Clementine Dusk</sys:String>
    <sys:String x:Key="ThemeCategory">Classic Player Archetypes</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#121820" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#1B2430" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#121820" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#F97316" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#F97316" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#FFF7ED" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#1B2430" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#F97316" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#1B2430" />
</ResourceDictionary>