<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Omni Player Theme Manifest: One Dark Pro (Modern Flat &amp; Fluent) -->
    <sys:String x:Key="ThemeId">one-dark-pro</sys:String>
    <sys:String x:Key="ThemeName">One Dark Pro</sys:String>
    <sys:String x:Key="ThemeCategory">Modern Flat &amp; Fluent</sys:String>
    <CornerRadius x:Key="OmniCornerRadius">6</CornerRadius>
    <sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="OmniBackgroundBrush" Color="#21252B" />
    <SolidColorBrush x:Key="OmniSurfaceBrush" Color="#282C34" />
    <SolidColorBrush x:Key="OmniHeaderBrush" Color="#21252B" />
    <SolidColorBrush x:Key="OmniBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="OmniAccentBrush" Color="#61AFEF" />
    <SolidColorBrush x:Key="OmniAccentHoverBrush" Color="#61AFEF" />
    <SolidColorBrush x:Key="OmniForegroundBrush" Color="#ABB2BF" />
    <SolidColorBrush x:Key="OmniMutedForegroundBrush" Color="#888888" />
    <SolidColorBrush x:Key="OmniControlBackgroundBrush" Color="#282C34" />
    <SolidColorBrush x:Key="OmniControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="OmniSliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="OmniSliderThumbBrush" Color="#61AFEF" />
    <SolidColorBrush x:Key="OmniDialogBackgroundBrush" Color="#282C34" />
</ResourceDictionary>