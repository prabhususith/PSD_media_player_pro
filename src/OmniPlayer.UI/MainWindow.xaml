<Window x:Class="OmniPlayer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="PSD Media Player Pro Edition"
        Height="720" Width="1180"
        MinHeight="480" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource OmniBackgroundBrush}"
        Foreground="{DynamicResource OmniForegroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        MouseMove="Window_MouseMove"
        MouseWheel="Window_MouseWheel">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Menu Bar -->
            <RowDefinition Height="*"/>    <!-- Video Surface & OSD -->
            <RowDefinition Height="Auto"/> <!-- Scrub bar & Timeline -->
            <RowDefinition Height="Auto"/> <!-- Controls bar -->
            <RowDefinition Height="Auto"/> <!-- Status Strip -->
        </Grid.RowDefinitions>

        <!-- Top Menu Bar -->
        <Border x:Name="BorderTopMenu" Grid.Row="0" Background="{DynamicResource OmniHeaderBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="0,0,0,1"
                MouseEnter="ControlsArea_MouseEnter" MouseMove="ControlsArea_MouseMove">
            <Menu Background="Transparent" Foreground="{DynamicResource OmniForegroundBrush}">
                <!-- File Menu -->
                <MenuItem Header="_File">
                    <MenuItem Header="_Open File..." Click="MenuOpenFile_Click" InputGestureText="Ctrl+O"/>
                    <MenuItem Header="Open _URL / YouTube / Stream..." Click="MenuOpenUrl_Click" InputGestureText="Ctrl+U"/>
                    <MenuItem Header="📡 Live _TV &amp; IPTV Hub (1000+ Channels)..." Click="MenuLiveTv_Click" InputGestureText="Ctrl+L"/>
                    <MenuItem Header="Open _Disc / ISO..." Click="MenuOpenDisc_Click"/>
                    <Separator/>
                    <MenuItem Header="⚙ _Settings &amp; Advanced Options..." Click="MenuSettings_Click" InputGestureText="Ctrl+,"/>
                    <Separator/>
                    <MenuItem Header="E_xit" Click="MenuExit_Click" InputGestureText="Alt+F4"/>
                </MenuItem>

                <!-- Playback Menu -->
                <MenuItem Header="_Playback">
                    <MenuItem Header="_Play / Pause" Click="BtnPlayPause_Click" InputGestureText="Space"/>
                    <MenuItem Header="_Stop" Click="BtnStop_Click" InputGestureText="Ctrl+S"/>
                    <Separator/>
                    <MenuItem Header="Jump Forward 5s" Click="MenuJumpForward5_Click" InputGestureText="Right"/>
                    <MenuItem Header="Jump Backward 5s" Click="MenuJumpBackward5_Click" InputGestureText="Left"/>
                    <MenuItem Header="Jump Forward 30s" Click="MenuJumpForward30_Click" InputGestureText="Ctrl+Right"/>
                    <MenuItem Header="Jump Backward 30s" Click="MenuJumpBackward30_Click" InputGestureText="Ctrl+Left"/>
                    <MenuItem Header="Jump Forward 1s (Nudge)" Click="MenuJumpForward1_Click" InputGestureText="Shift+Right"/>
                    <MenuItem Header="Jump Backward 1s (Nudge)" Click="MenuJumpBackward1_Click" InputGestureText="Shift+Left"/>
                    <Separator/>
                    <MenuItem Header="Playback Speed">
                        <MenuItem Header="0.25x (Slow Motion)" Click="MenuSpeed_Click" Tag="0.25"/>
                        <MenuItem Header="0.5x" Click="MenuSpeed_Click" Tag="0.5"/>
                        <MenuItem Header="0.75x" Click="MenuSpeed_Click" Tag="0.75"/>
                        <MenuItem Header="1.0x (Normal)" Click="MenuSpeed_Click" Tag="1.0" IsChecked="True"/>
                        <MenuItem Header="1.25x" Click="MenuSpeed_Click" Tag="1.25"/>
                        <MenuItem Header="1.5x" Click="MenuSpeed_Click" Tag="1.5"/>
                        <MenuItem Header="2.0x (Double Speed)" Click="MenuSpeed_Click" Tag="2.0"/>
                    </MenuItem>
                </MenuItem>

                <!-- Video Menu -->
                <MenuItem Header="_Video">
                    <MenuItem Header="_Fullscreen" Click="BtnFullscreen_Click" InputGestureText="F11 / Enter / F"/>
                    <MenuItem Header="👁 Hide / Toggle Controls" Click="BtnToggleControls_Click" InputGestureText="H / Ctrl+H"/>
                    <Separator/>
                    <MenuItem Header="Aspect Ratio">
                        <MenuItem Header="Auto (Stream Aspect)" Click="MenuAspect_Click" Tag="Auto" IsChecked="True"/>
                        <MenuItem Header="16:9 Widescreen" Click="MenuAspect_Click" Tag="16:9"/>
                        <MenuItem Header="4:3 Standard" Click="MenuAspect_Click" Tag="4:3"/>
                        <MenuItem Header="16:10 Display" Click="MenuAspect_Click" Tag="16:10"/>
                        <MenuItem Header="21:9 Ultrawide Cinema" Click="MenuAspect_Click" Tag="21:9"/>
                        <MenuItem Header="1:1 Square" Click="MenuAspect_Click" Tag="1:1"/>
                        <MenuItem Header="Stretch to Window" Click="MenuAspect_Click" Tag="Fill"/>
                        <Separator/>
                        <MenuItem Header="Cycle Aspect Ratio" Click="MenuCycleAspect_Click" InputGestureText="A"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Performance &amp; Shader Hub..." Click="MenuPerformance_Click" InputGestureText="F4"/>
                </MenuItem>

                <!-- View Menu (4 Dynamic View Modes) -->
                <MenuItem Header="_View">
                    <MenuItem Header="🪟 View Mode">
                        <MenuItem Header="1. Basic View (Minimalist Transport)" x:Name="MenuVModeBasic" Click="MenuViewModeBasic_Click" InputGestureText="Ctrl+1"/>
                        <MenuItem Header="2. Normal View (Full Desktop Player)" x:Name="MenuVModeNormal" Click="MenuViewModeNormal_Click" InputGestureText="Ctrl+2" IsChecked="True"/>
                        <MenuItem Header="3. Advanced View (Studio Telemetry HUD)" x:Name="MenuVModeAdvanced" Click="MenuViewModeAdvanced_Click" InputGestureText="Ctrl+3"/>
                        <MenuItem Header="4. Modern View (Floating Glass HUD)" x:Name="MenuVModeModern" Click="MenuViewModeModern_Click" InputGestureText="Ctrl+4"/>
                    </MenuItem>
                    <MenuItem Header="Cycle View Mode" Click="MenuCycleViewMode_Click" InputGestureText="V / F8"/>
                    <Separator/>
                    <MenuItem Header="📷 Camera Studio (Live AR &amp; Capture)..." Click="MenuCameraStudio_Click" InputGestureText="W / Ctrl+W"/>
                    <MenuItem Header="📁 Media Library Dashboard &amp; Auto-Scanner..." Click="MenuMediaLibrary_Click" InputGestureText="B / Ctrl+B"/>
                    <Separator/>
                    <MenuItem Header="_Fullscreen" Click="BtnFullscreen_Click" InputGestureText="F11 / Enter"/>
                    <MenuItem Header="🎛 Quick Control Panel..." Click="MenuControlPanel_Click" InputGestureText="F7 / Ctrl+P"/>
                    <MenuItem Header="Audio Equalizer (31-Band)..." Click="MenuEqualizer_Click" InputGestureText="F3"/>
                    <MenuItem Header="Video Performance Matrix..." Click="MenuPerformance_Click" InputGestureText="F4"/>
                </MenuItem>

                <!-- Audio Menu -->
                <MenuItem Header="_Audio">
                    <MenuItem Header="Audio _Equalizer &amp; DSP..." Click="MenuEqualizer_Click" InputGestureText="F3"/>
                    <Separator/>
                    <MenuItem Header="_Mute" Click="BtnMute_Click" InputGestureText="M"/>
                    <MenuItem Header="Volume +5%" Click="MenuVolUp_Click" InputGestureText="Up"/>
                    <MenuItem Header="Volume -5%" Click="MenuVolDown_Click" InputGestureText="Down"/>
                    <Separator/>
                    <MenuItem Header="WASAPI Exclusive Bitstreaming" IsCheckable="True" Click="MenuWasapiToggle_Click"/>
                </MenuItem>

                <!-- Subtitles Menu -->
                <MenuItem Header="_Subtitles">
                    <MenuItem Header="_Load Subtitle File..." Click="MenuLoadSubtitle_Click"/>
                    <MenuItem Header="_Download from OpenSubtitles..." Click="MenuDownloadSubtitles_Click"/>
                    <Separator/>
                    <MenuItem Header="Dual Subtitles (Top &amp; Bottom)" x:Name="MenuDualSubtitles" IsCheckable="True" Click="MenuDualSubtitles_Click"/>
                    <Separator/>
                    <MenuItem Header="Sync Offset -50ms" Click="MenuSubSync_Click" Tag="-50" InputGestureText="["/>
                    <MenuItem Header="Sync Offset +50ms" Click="MenuSubSync_Click" Tag="50" InputGestureText="]"/>
                    <MenuItem Header="Sync Offset -500ms" Click="MenuSubSync_Click" Tag="-500"/>
                    <MenuItem Header="Sync Offset +500ms" Click="MenuSubSync_Click" Tag="500"/>
                    <MenuItem Header="Reset Sync Offset" Click="MenuSubSync_Click" Tag="0"/>
                </MenuItem>

                <!-- Tools Menu (Comprehensive Swarm Delta Specification) -->
                <MenuItem Header="_Tools">
                    <MenuItem Header="📡 Live TV Hub (1000+ Channels)..." Click="MenuLiveTv_Click" InputGestureText="Ctrl+L"/>
                    <MenuItem Header="📁 Media Library Dashboard &amp; Auto-Scanner..." Click="MenuMediaLibrary_Click" InputGestureText="B / Ctrl+B"/>
                    <MenuItem Header="📷 Laptop &amp; USB Camera Studio &amp; AR Effects..." Click="MenuCameraStudio_Click" InputGestureText="W / Ctrl+W"/>
                    <MenuItem Header="🌐 Network Stream &amp; YouTube..." Click="MenuOpenUrl_Click" InputGestureText="Ctrl+U"/>
                    <MenuItem Header="📥 Online Media &amp; Video Downloader..." Click="MenuMediaDownloader_Click" InputGestureText="Ctrl+D"/>
                    <Separator/>
                    <MenuItem Header="🪟 View Mode" x:Name="MenuToolsViewMode">
                        <MenuItem Header="1. Basic View (Minimalist Transport)" Click="MenuViewModeBasic_Click" InputGestureText="Ctrl+1"/>
                        <MenuItem Header="2. Normal View (Full Desktop Player)" Click="MenuViewModeNormal_Click" InputGestureText="Ctrl+2"/>
                        <MenuItem Header="3. Advanced View (Studio Telemetry HUD)" Click="MenuViewModeAdvanced_Click" InputGestureText="Ctrl+3"/>
                        <MenuItem Header="4. Modern View (Floating Glass HUD)" Click="MenuViewModeModern_Click" InputGestureText="Ctrl+4"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Media _Information..." Click="MenuMediaInfo_Click" InputGestureText="Ctrl+I"/>
                    <MenuItem Header="_Capture Studio &amp; Frame Grabber..." Click="MenuCaptureStudio_Click" InputGestureText="Ctrl+G"/>
                    <MenuItem Header="🎛 Quick Control Panel (Video/Audio/Subs)..." Click="MenuControlPanel_Click" InputGestureText="F7 / Ctrl+P"/>
                    <Separator/>
                    <MenuItem Header="Audio Enhancement Hub (31-Band EQ)..." Click="MenuEqualizer_Click" InputGestureText="F3"/>
                    <MenuItem Header="Video Enhancement &amp; Performance Matrix..." Click="MenuPerformance_Click" InputGestureText="F4"/>
                    <Separator/>
                    <MenuItem Header="A-B Repeat: Set Point [A]" Click="MenuSetA_Click" InputGestureText="[ "/>
                    <MenuItem Header="A-B Repeat: Set Point [B]" Click="MenuSetB_Click" InputGestureText=" ]"/>
                    <MenuItem Header="A-B Repeat: Clear Loop" Click="MenuClearAB_Click" InputGestureText="\ "/>
                    <Separator/>
                    <MenuItem Header="⚙ Settings &amp; Preferences..." Click="MenuSettings_Click" InputGestureText="Ctrl+,"/>
                </MenuItem>

                <!-- Themes Menu (Dynamic Hot-Reloading 110+ Themes Catalog) -->
                <MenuItem Header="T_hemes" x:Name="MenuThemes">
                    <MenuItem Header="Classic Player Archetypes (25)" x:Name="MenuCatClassic"/>
                    <MenuItem Header="Modern Flat &amp; Fluent (35)" x:Name="MenuCatModern"/>
                    <MenuItem Header="Studio Glass &amp; Acrylic (25)" x:Name="MenuCatGlass"/>
                    <MenuItem Header="High-Contrast &amp; Gamer Skins (25)" x:Name="MenuCatGamer"/>
                </MenuItem>

                <!-- Help Menu -->
                <MenuItem Header="_Help">
                    <MenuItem Header="Interactive Help &amp; Master User Guide..." Click="MenuHelpGuide_Click" InputGestureText="F1"/>
                    <Separator/>
                    <MenuItem Header="About PSD Media Player Pro..." Click="MenuAbout_Click"/>
                </MenuItem>
            </Menu>
        </Border>

        <!-- Video Viewport / D3D11 Surface & Subtitles Overlay -->
        <Grid x:Name="VideoGrid" Grid.Row="1" Background="#000000" ClipToBounds="True"
              MouseLeftButtonDown="VideoGrid_MouseLeftButtonDown"
              MouseRightButtonUp="VideoGrid_MouseRightButtonUp">
            <Grid.ContextMenu>
                <ContextMenu x:Name="VideoContextMenu">
                    <MenuItem Header="▶ Play / ⏸ Pause" Click="BtnPlayPause_Click" InputGestureText="Space / K"/>
                    <MenuItem Header="■ Stop" Click="BtnStop_Click" InputGestureText="Ctrl+S"/>
                    <Separator/>
                    <MenuItem Header="⛶ Toggle Fullscreen" Click="BtnFullscreen_Click" InputGestureText="F11 / Enter / F"/>
                    <MenuItem Header="👁 Hide / Toggle Controls" Click="BtnToggleControls_Click" InputGestureText="H / Ctrl+H"/>
                    <Separator/>
                    <MenuItem Header="🪟 View Mode">
                        <MenuItem Header="1. Basic View (Minimalist Transport)" Click="MenuViewModeBasic_Click" InputGestureText="Ctrl+1"/>
                        <MenuItem Header="2. Normal View (Full Desktop Player)" Click="MenuViewModeNormal_Click" InputGestureText="Ctrl+2"/>
                        <MenuItem Header="3. Advanced View (Studio Telemetry HUD)" Click="MenuViewModeAdvanced_Click" InputGestureText="Ctrl+3"/>
                        <MenuItem Header="4. Modern View (Floating Glass HUD)" Click="MenuViewModeModern_Click" InputGestureText="Ctrl+4"/>
                        <Separator/>
                        <MenuItem Header="Cycle View Mode" Click="MenuCycleViewMode_Click" InputGestureText="V / F8"/>
                    </MenuItem>
                    <MenuItem Header="📐 Aspect Ratio">
                        <MenuItem Header="Auto (Stream Aspect)" Click="MenuAspect_Click" Tag="Auto"/>
                        <MenuItem Header="16:9 Widescreen" Click="MenuAspect_Click" Tag="16:9"/>
                        <MenuItem Header="4:3 Standard" Click="MenuAspect_Click" Tag="4:3"/>
                        <MenuItem Header="16:10 Display" Click="MenuAspect_Click" Tag="16:10"/>
                        <MenuItem Header="21:9 Ultrawide Cinema" Click="MenuAspect_Click" Tag="21:9"/>
                        <MenuItem Header="1:1 Square" Click="MenuAspect_Click" Tag="1:1"/>
                        <MenuItem Header="Stretch to Window" Click="MenuAspect_Click" Tag="Fill"/>
                        <Separator/>
                        <MenuItem Header="Cycle Aspect Ratio" Click="MenuCycleAspect_Click" InputGestureText="A"/>
                    </MenuItem>
                    <MenuItem Header="⏩ Playback Speed">
                        <MenuItem Header="0.10x Ultra Slow Motion" Click="MenuSpeedPreset_Click" Tag="0.1"/>
                        <MenuItem Header="0.25x Quarter Speed Slow" Click="MenuSpeedPreset_Click" Tag="0.25"/>
                        <MenuItem Header="0.5x Half Speed" Click="MenuSpeedPreset_Click" Tag="0.5"/>
                        <MenuItem Header="0.75x Slower" Click="MenuSpeedPreset_Click" Tag="0.75"/>
                        <MenuItem Header="1.0x Normal Speed" Click="MenuSpeedPreset_Click" Tag="1.0" IsChecked="True"/>
                        <MenuItem Header="1.25x Faster" Click="MenuSpeedPreset_Click" Tag="1.25"/>
                        <MenuItem Header="1.5x Fast" Click="MenuSpeedPreset_Click" Tag="1.5"/>
                        <MenuItem Header="2.0x Double Speed" Click="MenuSpeedPreset_Click" Tag="2.0"/>
                        <MenuItem Header="3.0x Triple Speed" Click="MenuSpeedPreset_Click" Tag="3.0"/>
                        <MenuItem Header="4.0x Quad Speed" Click="MenuSpeedPreset_Click" Tag="4.0"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="📁 Media Library &amp; Device Scanner..." Click="MenuMediaLibrary_Click" InputGestureText="B / Ctrl+B"/>
                    <MenuItem Header="📷 Laptop Camera Studio &amp; Live AR..." Click="MenuCameraStudio_Click" InputGestureText="W / Ctrl+W"/>
                    <MenuItem Header="🔴 Toggle Live Telecast Recording" Click="BtnRecord_Click" InputGestureText="R"/>
                    <MenuItem Header="📸 Capture Frame Snapshot" Click="BtnQuickCapture_Click" InputGestureText="S / Ctrl+G"/>
                    <MenuItem Header="⏭ Step 1 Frame Forward" Click="BtnStepForward_Click" InputGestureText="."/>
                    <MenuItem Header="⏮ Step 1 Frame Backward" Click="BtnStepBack_Click" InputGestureText=","/>
                    <Separator/>
                    <MenuItem Header="🎚 Audio Equalizer &amp; DSP Studio (31-Band)..." Click="MenuEqualizer_Click" InputGestureText="F3 / E"/>
                    <MenuItem Header="🎛 Quick Control Panel..." Click="MenuControlPanel_Click" InputGestureText="F7 / Ctrl+P"/>
                    <MenuItem Header="📡 Global Live TV Hub (1000+ Channels)..." Click="MenuLiveTv_Click" InputGestureText="Ctrl+L / L"/>
                    <MenuItem Header="🌐 Network Stream &amp; YouTube..." Click="MenuOpenUrl_Click" InputGestureText="Ctrl+U / U"/>
                    <MenuItem Header="📥 Online Media &amp; Video Downloader..." Click="MenuMediaDownloader_Click" InputGestureText="Ctrl+D"/>
                    <MenuItem Header="🎨 Themes &amp; Skins (110+ Catalog)..." Click="MenuNextTheme_Click" InputGestureText="T"/>
                    <Separator/>
                    <MenuItem Header="⚙ Preferences &amp; Settings..." Click="MenuSettings_Click" InputGestureText="Ctrl+,"/>
                    <MenuItem Header="ℹ Media Information..." Click="MenuMediaInfo_Click" InputGestureText="Ctrl+I"/>
                    <MenuItem Header="📖 Interactive Help &amp; Master User Guide..." Click="MenuHelpGuide_Click" InputGestureText="F1"/>
                    <MenuItem Header="ℹ About PSD Media Player Pro..." Click="MenuAbout_Click"/>
                    <Separator/>
                    <MenuItem Header="❌ Exit" Click="MenuExit_Click" InputGestureText="Alt+F4"/>
                </ContextMenu>
            </Grid.ContextMenu>
            <!-- LibVLC Sharp Hardware-Accelerated Video Surface -->
            <vlc:VideoView x:Name="VlcVideoView"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Visibility="Visible"/>

            <!-- Fallback WPF MediaElement Presentation -->
            <MediaElement x:Name="PlayerMediaElement"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          ScrubbingEnabled="True"
                          MediaOpened="PlayerMediaElement_MediaOpened"
                          MediaEnded="PlayerMediaElement_MediaEnded"
                          Stretch="Uniform"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Visibility="Collapsed"/>

            <!-- Secondary Subtitle Overlay (Top Center) -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,30,0,0">
                <TextBlock x:Name="TxtSecondarySubtitle"
                           Text=""
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#FFE066"
                           TextAlignment="Center"
                           Visibility="Collapsed">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1.5" Color="#000000" Opacity="0.9"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Border>

            <!-- Primary Subtitle Overlay (Bottom Center) -->
            <Border x:Name="BorderPrimarySubtitle" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,45">
                <TextBlock x:Name="TxtPrimarySubtitle"
                           Text=""
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           TextAlignment="Center"
                           Visibility="Collapsed">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="#000000" Opacity="0.95"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Border>

            <!-- Studio Telemetry HUD Overlay (Advanced View Mode) -->
            <Border x:Name="BorderTelemetryHud"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="16"
                    Background="#D90C1017"
                    BorderBrush="{DynamicResource OmniAccentBrush}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="14,10"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Color="#000000" Opacity="0.8"/>
                </Border.Effect>
                <StackPanel Width="290">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="📊 STUDIO TELEMETRY HUD" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OmniAccentBrush}"/>
                        <TextBlock Text="ADVANCED MODE" HorizontalAlignment="Right" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                    </Grid>
                    <Separator Background="#33FFFFFF" Margin="0,0,0,6"/>
                    <Grid Margin="0,2">
                        <TextBlock Text="Engine Pipeline:" FontSize="10" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                        <TextBlock x:Name="TxtTelemEngine" Text="LibVLC 3.0.24 Direct3D 11" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OmniForegroundBrush}"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="Hardware Dec:" FontSize="10" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                        <TextBlock x:Name="TxtTelemHwDec" Text="D3D11VA (Zero-Copy)" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="Resolution &amp; FPS:" FontSize="10" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                        <TextBlock x:Name="TxtTelemResFps" Text="Auto / 60.00 FPS" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OmniForegroundBrush}"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="Audio DSP Engine:" FontSize="10" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                        <TextBlock x:Name="TxtTelemAudio" Text="31-Band Parametric + WASAPI" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="#A78BFA"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="Equalizer Profile:" FontSize="10" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                        <TextBlock x:Name="TxtTelemEqPreset" Text="Flat (0.0 dB Preamp)" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OmniForegroundBrush}"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="Dropped Frames:" FontSize="10" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                        <TextBlock x:Name="TxtTelemDrops" Text="0 frames (0.00%)" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="#34D399"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="Buffer Caching:" FontSize="10" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                        <TextBlock x:Name="TxtTelemBuffer" Text="3000ms Net / 1000ms File" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OmniForegroundBrush}"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="A-B Repeat:" FontSize="10" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                        <TextBlock x:Name="TxtTelemAb" Text="Off" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OmniAccentBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Floating Modern Glass HUD (Modern View Mode) -->
            <Border x:Name="BorderModernHud"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,24"
                    Background="#E610141D"
                    BorderBrush="{DynamicResource OmniAccentBrush}"
                    BorderThickness="1.5"
                    CornerRadius="20"
                    Padding="16,10"
                    MouseEnter="ControlsArea_MouseEnter" MouseMove="ControlsArea_MouseMove"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Color="#000000" Opacity="0.85"/>
                </Border.Effect>
                <StackPanel Width="860">
                    <!-- Modern Scrub Slider & Time -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtModernTimeElapsed" Text="00:00:00" FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <!-- Floating Modern Seek Time Preview Popup -->
                        <Popup x:Name="PopupModernSeekPreview" Placement="Top" PlacementTarget="{Binding ElementName=SliderModernTimeline}"
                               AllowsTransparency="True" StaysOpen="False" IsHitTestVisible="False">
                            <Border Background="#F0181818" BorderBrush="{DynamicResource OmniAccentBrush}" BorderThickness="1.5"
                                    CornerRadius="6" Padding="10,5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Color="#000000" Opacity="0.85"/>
                                </Border.Effect>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtModernSeekPreviewTime" Text="00:00:00" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtModernSeekPreviewPercent" Text="0.0%" FontSize="10" Foreground="{DynamicResource OmniAccentBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Slider x:Name="SliderModernTimeline" Grid.Column="1"
                                Minimum="0" Maximum="1000" Value="0"
                                SmallChange="1" LargeChange="10"
                                IsMoveToPointEnabled="True"
                                PreviewMouseDown="SliderTimeline_PreviewMouseDown"
                                PreviewMouseUp="SliderTimeline_PreviewMouseUp"
                                PreviewMouseMove="SliderTimeline_PreviewMouseMove"
                                MouseEnter="SliderTimeline_MouseEnter"
                                MouseLeave="SliderTimeline_MouseLeave"
                                ValueChanged="SliderTimeline_ValueChanged"/>
                        <TextBlock x:Name="TxtModernTimeTotal" Grid.Column="2" Text="00:00:00" FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Modern Transport Controls -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left buttons -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnModernPlayPause" Content="▶ Play" Click="BtnPlayPause_Click" Width="72" Height="30" FontWeight="Bold" Background="{DynamicResource OmniAccentBrush}" Foreground="#FFFFFF" BorderThickness="0" Margin="0,0,4,0"/>
                            <Button Content="■ Stop" Click="BtnStop_Click" Width="56" Height="30" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,4,0"/>
                            <Button Content="⏮" Click="BtnPrev_Click" Width="30" Height="30" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,3,0"/>
                            <Button Content="⏭" Click="BtnNext_Click" Width="30" Height="30" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}"/>
                        </StackPanel>

                        <!-- Center Quick Badges -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Content="📡 Live TV" Click="MenuLiveTv_Click" Height="28" Padding="6,0" FontWeight="Bold" Background="{DynamicResource OmniAccentBrush}" Foreground="#FFFFFF" BorderThickness="0" Margin="0,0,4,0"/>
                            <Button Content="📁 Library" Click="MenuMediaLibrary_Click" Height="28" Padding="6,0" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,4,0" ToolTip="Media Library &amp; Auto-Scanner (B)"/>
                            <Button Content="📷 Camera" Click="MenuCameraStudio_Click" Height="28" Padding="6,0" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,4,0" ToolTip="Camera Studio &amp; AR FX (W)"/>
                            <Button Content="🌐 URL" Click="MenuOpenUrl_Click" Height="28" Padding="6,0" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,4,0"/>
                            <Button Content="🐌 Slow Mo" Click="BtnSlowMo_Click" Height="28" Padding="6,0" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,4,0" ToolTip="YouTube-Style Slow Motion"/>
                            <Button Content="🎚 EQ" Click="MenuEqualizer_Click" Height="28" Padding="6,0" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,4,0"/>
                            <Button Content="🎛 Controls" Click="MenuControlPanel_Click" Height="28" Padding="6,0" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,4,0"/>
                            <Button x:Name="BtnModernViewMode" Content="🪟 Modern" Click="MenuCycleViewMode_Click" Height="28" Padding="6,0" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" ToolTip="Cycle View Mode (V / F8)"/>
                        </StackPanel>

                        <!-- Right buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="🔊" Click="BtnMute_Click" Width="30" Height="28" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,4,0"/>
                            <Slider x:Name="SliderModernVolume" Minimum="0" Maximum="1" Value="0.8" Width="75" VerticalAlignment="Center" ValueChanged="SliderVolume_ValueChanged" Margin="0,0,6,0"/>
                            <Button x:Name="BtnModernPinControls" Content="📌" Click="BtnPinControls_Click" Width="30" Height="28" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,4,0" ToolTip="Pin Controls: Keep controls visible in Fullscreen (H / Ctrl+H)"/>
                            <Button x:Name="BtnModernToggleControls" Content="👁" Click="BtnToggleControls_Click" Width="30" Height="28" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,4,0" ToolTip="Toggle / Hide Controls (H)"/>
                            <Button Content="⛶" Click="BtnFullscreen_Click" Width="32" Height="28" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- On-Screen Display (OSD) Notification Banner -->
            <Border x:Name="BorderOsd" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20" Background="#CC000000" CornerRadius="6" Padding="14,8" Visibility="Collapsed">
                <TextBlock x:Name="TxtOsd" Text="PSD Media Player Ready" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
            </Border>

            <!-- Live Stream Recording Telemetry HUD Badge -->
            <Border x:Name="BorderRecordingHud" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20"
                    Background="#E5D32F2F" CornerRadius="6" Padding="12,6" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#000000" Opacity="0.8"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔴 REC" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TxtRecordingDuration" Text="00:00:00" FontSize="12" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TxtRecordingBytes" Text="0.0 MB" FontSize="12" Foreground="#FFE082"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Timeline Scrub Bar & A-B Repeat Markers -->
        <Border x:Name="BorderTimeline" Grid.Row="2" Background="{DynamicResource OmniSurfaceBrush}" Padding="16,8,16,4" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="0,1,0,0"
                MouseEnter="ControlsArea_MouseEnter" MouseMove="ControlsArea_MouseMove">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Floating Seek Time Preview Popup (YouTube Style) -->
                <Popup x:Name="PopupSeekPreview" Placement="Top" PlacementTarget="{Binding ElementName=SliderTimeline}"
                       AllowsTransparency="True" StaysOpen="False" IsHitTestVisible="False">
                    <Border Background="#F0181818" BorderBrush="{DynamicResource OmniAccentBrush}" BorderThickness="1.5"
                            CornerRadius="6" Padding="10,5">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Color="#000000" Opacity="0.85"/>
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtSeekPreviewTime" Text="00:00:00" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtSeekPreviewPercent" Text="0.0%" FontSize="10" Foreground="{DynamicResource OmniAccentBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Slider with IsMoveToPointEnabled for smooth direct seek on click -->
                <Slider x:Name="SliderTimeline"
                        Minimum="0" Maximum="1000" Value="0"
                        SmallChange="1" LargeChange="10"
                        IsMoveToPointEnabled="True"
                        PreviewMouseDown="SliderTimeline_PreviewMouseDown"
                        PreviewMouseUp="SliderTimeline_PreviewMouseUp"
                        PreviewMouseMove="SliderTimeline_PreviewMouseMove"
                        MouseEnter="SliderTimeline_MouseEnter"
                        MouseLeave="SliderTimeline_MouseLeave"
                        ValueChanged="SliderTimeline_ValueChanged"/>

                <Grid Grid.Row="1" Margin="2,4,2,0">
                    <TextBlock x:Name="TxtTimeElapsed" Text="00:00:00" FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TxtAbRepeatDisplay" Text="" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OmniAccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtTimeTotal" Text="00:00:00" FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}" HorizontalAlignment="Right"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Playback Controls Bar -->
        <Border x:Name="BorderControls" Grid.Row="3" Background="{DynamicResource OmniSurfaceBrush}" Padding="16,6,16,10"
                MouseEnter="ControlsArea_MouseEnter" MouseMove="ControlsArea_MouseMove">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Controls: Play, Pause, Stop, Prev, Next, Step Back/Forward -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPlayPause" Content="▶ Play" Click="BtnPlayPause_Click" Width="78" Height="34" FontWeight="Bold" Background="{DynamicResource OmniAccentBrush}" Foreground="#FFFFFF" BorderThickness="0" Margin="0,0,4,0"/>
                    <Button x:Name="BtnStop" Content="■ Stop" Click="BtnStop_Click" Width="66" Height="34" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,4,0"/>
                    <Button x:Name="BtnPrev" Content="⏮" Click="BtnPrev_Click" Width="34" Height="34" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,3,0" ToolTip="Jump to Start"/>
                    <Button x:Name="BtnStepBack" Content="⏮ 1f" Click="BtnStepBack_Click" Width="40" Height="34" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,3,0" ToolTip="Step 1 Frame Backward (,)"/>
                    <Button x:Name="BtnStepForward" Content="⏭ 1f" Click="BtnStepForward_Click" Width="40" Height="34" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,3,0" ToolTip="Step 1 Frame Forward (.)"/>
                    <Button x:Name="BtnNext" Content="⏭" Click="BtnNext_Click" Width="34" Height="34" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" ToolTip="Next Media / Chapter"/>
                </StackPanel>

                <!-- Center: Quick Action Badges (Live TV, Library, Camera, URL, Speed, SlowMo, Record, View Mode, EQ, Controls, Snap, Settings) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="BtnLiveTv" Content="📡 Live TV" Click="MenuLiveTv_Click" Height="30" Padding="8,0" FontWeight="Bold" Background="{DynamicResource OmniAccentBrush}" Foreground="#FFFFFF" BorderThickness="0" Margin="0,0,4,0"/>
                    <Button x:Name="BtnMediaLibrary" Content="📁 Library" Click="MenuMediaLibrary_Click" Height="30" Padding="6,0" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,4,0" ToolTip="Media Library &amp; Device Auto-Scan Dashboard (B)"/>
                    <Button x:Name="BtnCamera" Content="📷 Camera" Click="MenuCameraStudio_Click" Height="30" Padding="6,0" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,4,0" ToolTip="Laptop &amp; USB Camera Studio with Live AR Effects (W)"/>
                    <Button x:Name="BtnStream" Content="🌐 URL" Click="MenuOpenUrl_Click" Height="30" Padding="6,0" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,4,0"/>
                    <Button x:Name="BtnSpeed" Content="⚡ 1.0x" Click="BtnSpeed_Click" Height="30" Padding="6,0" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,4,0" ToolTip="Playback Speed: Click to cycle presets, right-click for list ([ / ])"/>
                    <Button x:Name="BtnSlowMo" Content="🐌 Slow Mo" Click="BtnSlowMo_Click" Height="30" Padding="6,0" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,4,0" ToolTip="YouTube-Style Slow Motion (0.1x, 0.25x, 0.5x, 0.75x)"/>
                    <Button x:Name="BtnRecord" Content="🔴 Rec" Click="BtnRecord_Click" Height="30" Padding="6,0" FontWeight="SemiBold" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="#EF5350" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,4,0" ToolTip="Record Live Stream Telecast (R)"/>
                    <Button x:Name="BtnViewMode" Content="🪟 View" Click="MenuCycleViewMode_Click" Height="30" Padding="6,0" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,4,0" ToolTip="Switch View Mode (V / F8)"/>
                    <Button x:Name="BtnQuickEq" Content="🎚 EQ" Click="MenuEqualizer_Click" Height="30" Padding="6,0" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,4,0"/>
                    <Button x:Name="BtnQuickControlPanel" Content="🎛 Controls" Click="MenuControlPanel_Click" Height="30" Padding="6,0" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,4,0" ToolTip="Quick Control Panel (F7 / Ctrl+P)"/>
                    <Button x:Name="BtnQuickCapture" Content="📷 Snap" Click="BtnQuickCapture_Click" Height="30" Padding="6,0" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,4,0" ToolTip="Capture Video Frame Snapshot (S)"/>
                    <Button x:Name="BtnSettings" Content="⚙" Click="MenuSettings_Click" Height="30" Width="30" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" ToolTip="Settings &amp; Options (Ctrl+, / P)"/>
                </StackPanel>

                <!-- Right: Volume Slider & Fullscreen -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnMute" Content="🔊" Click="BtnMute_Click" Width="36" Height="32" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,6,0"/>
                    <Slider x:Name="SliderVolume" Minimum="0" Maximum="1" Value="0.8" Width="95" VerticalAlignment="Center" ValueChanged="SliderVolume_ValueChanged" Margin="0,0,10,0"/>
                    <Button x:Name="BtnPinControls" Content="📌" Click="BtnPinControls_Click" Width="36" Height="32" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,6,0" ToolTip="Pin Controls: Keep controls visible in Fullscreen (H / Ctrl+H)"/>
                    <Button x:Name="BtnToggleControls" Content="👁 Toggle UI" Click="BtnToggleControls_Click" Height="32" Padding="8,0" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" Margin="0,0,6,0" ToolTip="Toggle / Hide On-Screen Controls (H / Ctrl+H)"/>
                    <Button x:Name="BtnFullscreen" Content="⛶ Fullscreen" Click="BtnFullscreen_Click" Height="32" Padding="10,0" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom Status Bar -->
        <Border x:Name="BorderStatusBar" Grid.Row="4" Background="{DynamicResource OmniHeaderBrush}" Padding="12,3" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="TxtStatusLeft" Text="Direct3D 11 Video Acceleration Active | 0 Drops | 60.00 fps" FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                <TextBlock x:Name="TxtStatusRight" Text="110+ Skins Available | High-Fidelity 31-Band Audio DSP Engine" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
