<Window x:Class="OmniPlayer.UI.Views.ControlPanelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PSD Media Player - Control Panel"
        Height="640" Width="520"
        MinHeight="550" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource OmniBackgroundBrush}"
        Foreground="{DynamicResource OmniForegroundBrush}"
        ResizeMode="CanResize">
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Tabs -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Top High-Tech Header Banner -->
        <Border Grid.Row="0" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,10" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎛" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="PSD Control Panel" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource OmniAccentBrush}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource OmniControlBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LIVE DSP" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OmniAccentBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Real-time Video, Audio, Subtitle &amp; Playback Controller" FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="24,3,0,0"/>
                </StackPanel>

                <CheckBox x:Name="ChkAlwaysOnTop" Grid.Column="1" Content="Always on Top" VerticalAlignment="Center" FontWeight="SemiBold"
                          Foreground="{DynamicResource OmniForegroundBrush}" Checked="ChkAlwaysOnTop_Changed" Unchecked="ChkAlwaysOnTop_Changed"/>
            </Grid>
        </Border>

        <!-- 4 Core Functional Tabs -->
        <TabControl Grid.Row="1" Background="{DynamicResource OmniSurfaceBrush}" BorderBrush="{DynamicResource OmniBorderBrush}">
            
            <!-- ==================== 1. VIDEO TAB ==================== -->
            <TabItem Header="  🎬 Video  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
                    <StackPanel>
                        <!-- Color & Picture Adjustment Section -->
                        <Border Background="{DynamicResource OmniControlBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="PICTURE &amp; COLOR GRADING" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,0,0,8"/>
                                
                                <!-- Brightness -->
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Brightness:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" FontSize="12"/>
                                    <Slider x:Name="SliderBrightness" Grid.Column="1" Minimum="-100" Maximum="100" Value="0" SmallChange="1" LargeChange="5"
                                            VerticalAlignment="Center" ValueChanged="PictureSlider_ValueChanged"/>
                                    <TextBlock x:Name="TxtBrightnessVal" Grid.Column="2" Text="0" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                </Grid>

                                <!-- Contrast -->
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Contrast:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" FontSize="12"/>
                                    <Slider x:Name="SliderContrast" Grid.Column="1" Minimum="-100" Maximum="100" Value="0" SmallChange="1" LargeChange="5"
                                            VerticalAlignment="Center" ValueChanged="PictureSlider_ValueChanged"/>
                                    <TextBlock x:Name="TxtContrastVal" Grid.Column="2" Text="0" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                </Grid>

                                <!-- Saturation -->
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Saturation:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" FontSize="12"/>
                                    <Slider x:Name="SliderSaturation" Grid.Column="1" Minimum="-100" Maximum="100" Value="0" SmallChange="1" LargeChange="5"
                                            VerticalAlignment="Center" ValueChanged="PictureSlider_ValueChanged"/>
                                    <TextBlock x:Name="TxtSaturationVal" Grid.Column="2" Text="0" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                </Grid>

                                <!-- Hue -->
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Hue:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" FontSize="12"/>
                                    <Slider x:Name="SliderHue" Grid.Column="1" Minimum="-180" Maximum="180" Value="0" SmallChange="1" LargeChange="10"
                                            VerticalAlignment="Center" ValueChanged="PictureSlider_ValueChanged"/>
                                    <TextBlock x:Name="TxtHueVal" Grid.Column="2" Text="0°" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                </Grid>

                                <!-- Gamma -->
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Gamma:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" FontSize="12"/>
                                    <Slider x:Name="SliderGamma" Grid.Column="1" Minimum="0.2" Maximum="3.0" Value="1.0" SmallChange="0.05" LargeChange="0.1"
                                            VerticalAlignment="Center" ValueChanged="PictureSlider_ValueChanged"/>
                                    <TextBlock x:Name="TxtGammaVal" Grid.Column="2" Text="1.00" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                </Grid>

                                <!-- Reset Button -->
                                <Button x:Name="BtnResetVideo" Content="🔄 Reset Video Adjustments" Click="BtnResetVideo_Click" Height="28" Margin="0,8,0,0"
                                        Background="{DynamicResource OmniSurfaceBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Geometry & Aspect Ratio Section -->
                        <Border Background="{DynamicResource OmniControlBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1" Padding="10">
                            <StackPanel>
                                <TextBlock Text="ASPECT RATIO &amp; DEINTERLACING" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,0,0,8"/>

                                <Grid Margin="0,2,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Aspect Ratio:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" FontSize="12"/>
                                    <ComboBox x:Name="CmbAspectRatio" Grid.Column="1" Height="28" SelectionChanged="CmbAspectRatio_SelectionChanged"
                                              Background="{DynamicResource OmniSurfaceBrush}" Foreground="{DynamicResource OmniForegroundBrush}">
                                        <ComboBoxItem Content="Auto (Stream Aspect)" Tag="Auto" IsSelected="True"/>
                                        <ComboBoxItem Content="16:9 (Widescreen)" Tag="16:9"/>
                                        <ComboBoxItem Content="4:3 (Standard TV)" Tag="4:3"/>
                                        <ComboBoxItem Content="21:9 (Ultrawide Cinema)" Tag="21:9"/>
                                        <ComboBoxItem Content="Stretch to Window (Fill)" Tag="Fill"/>
                                    </ComboBox>
                                </Grid>

                                <CheckBox x:Name="ChkDeinterlacing" Content="Enable Deinterlacing (YADIF / Hardware Adaptive)" Margin="0,4,0,0"
                                          Foreground="{DynamicResource OmniForegroundBrush}" Checked="ChkDeinterlacing_Changed" Unchecked="ChkDeinterlacing_Changed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== 2. AUDIO TAB ==================== -->
            <TabItem Header="  🔊 Audio  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
                    <StackPanel>
                        <!-- Volume & Balance -->
                        <Border Background="{DynamicResource OmniControlBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="VOLUME &amp; STEREO BALANCE" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,0,0,8"/>

                                <!-- Master Volume -->
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Volume:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" FontSize="12"/>
                                    <Slider x:Name="SliderAudioVolume" Grid.Column="1" Minimum="0" Maximum="100" Value="80" SmallChange="1" LargeChange="5"
                                            VerticalAlignment="Center" ValueChanged="SliderAudioVolume_ValueChanged"/>
                                    <TextBlock x:Name="TxtVolumeVal" Grid.Column="2" Text="80%" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                </Grid>

                                <!-- Audio Balance (L / R) -->
                                <Grid Margin="0,6,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Balance:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" FontSize="12"/>
                                    <Slider x:Name="SliderAudioBalance" Grid.Column="1" Minimum="-100" Maximum="100" Value="0" SmallChange="1" LargeChange="10"
                                            VerticalAlignment="Center" ValueChanged="SliderAudioBalance_ValueChanged"/>
                                    <TextBlock x:Name="TxtBalanceVal" Grid.Column="2" Text="Center" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                </Grid>
                                <TextBlock Text="◄ Left (L)                       Center                       Right (R) ►" FontSize="10" Foreground="{DynamicResource OmniMutedForegroundBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Equalizer Preset & Pre-amp -->
                        <Border Background="{DynamicResource OmniControlBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="QUICK EQUALIZER PRESET &amp; PRE-AMP" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,0,0,8"/>

                                <Grid Margin="0,2,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="EQ Preset:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" FontSize="12"/>
                                    <ComboBox x:Name="CmbEqPreset" Grid.Column="1" Height="28" SelectionChanged="CmbEqPreset_SelectionChanged"
                                              Background="{DynamicResource OmniSurfaceBrush}" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                </Grid>

                                <!-- Pre-amp Gain Slider -->
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="55"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Pre-Amp:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" FontSize="12"/>
                                    <Slider x:Name="SliderPreamp" Grid.Column="1" Minimum="-20" Maximum="20" Value="0" SmallChange="0.5" LargeChange="2"
                                            VerticalAlignment="Center" ValueChanged="SliderPreamp_ValueChanged"/>
                                    <TextBlock x:Name="TxtPreampVal" Grid.Column="2" Text="0.0 dB" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource OmniAccentBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3D Sound Technologies -->
                        <Border Background="{DynamicResource OmniControlBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🌌 SOUND TECHNOLOGIES &amp; 3D SPATIAL" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Technology:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" FontSize="12"/>
                                    <ComboBox x:Name="CmbSoundTechnology" Grid.Column="1" Height="28" SelectionChanged="CmbSoundTechnology_SelectionChanged"
                                              Background="{DynamicResource OmniSurfaceBrush}" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Room Echo & Reverb Presets -->
                        <Border Background="{DynamicResource OmniControlBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🏛 ROOM ECHO &amp; REVERB PRESETS" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Room Preset:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" FontSize="12"/>
                                    <ComboBox x:Name="CmbRoomEcho" Grid.Column="1" Height="28" SelectionChanged="CmbRoomEcho_SelectionChanged"
                                              Background="{DynamicResource OmniSurfaceBrush}" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Reverb Wet:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" FontSize="12"/>
                                    <Slider x:Name="SliderReverbWet" Grid.Column="1" Minimum="0" Maximum="100" Value="25" SmallChange="1" LargeChange="10"
                                            VerticalAlignment="Center" ValueChanged="SliderReverbWet_ValueChanged"/>
                                    <TextBlock x:Name="TxtReverbWetVal" Grid.Column="2" Text="25%" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Pitch Tuning & Vocal Studio -->
                        <Border Background="{DynamicResource OmniControlBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🎵 PITCH TUNING &amp; VOCAL FX" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Pitch Shift:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" FontSize="12"/>
                                    <Slider x:Name="SliderPitch" Grid.Column="1" Minimum="-12" Maximum="12" Value="0" SmallChange="1" LargeChange="3"
                                            VerticalAlignment="Center" ValueChanged="SliderPitch_ValueChanged"/>
                                    <TextBlock x:Name="TxtPitchVal" Grid.Column="2" Text="0 st" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,0,4,0"/>
                                    <Button x:Name="BtnResetPitch" Grid.Column="3" Content="0" Click="BtnResetPitch_Click" Height="22" Width="26" FontSize="10" ToolTip="Reset Pitch to 0 Semitones"
                                            Background="{DynamicResource OmniSurfaceBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}"/>
                                </Grid>

                                <CheckBox x:Name="ChkKaraoke" Content="🎤 Karaoke Vocal Remover / Suppressor" Margin="0,4"
                                          Foreground="{DynamicResource OmniForegroundBrush}" Checked="DspOption_Changed" Unchecked="DspOption_Changed"/>

                                <CheckBox x:Name="ChkDialogueClarity" Content="🗣 Smart Dialogue Enhancer (Clarity Boost)" Margin="0,4"
                                          Foreground="{DynamicResource OmniForegroundBrush}" Checked="DspOption_Changed" Unchecked="DspOption_Changed"/>
                            </StackPanel>
                        </Border>

                        <!-- Dynamic Range & Spatialization -->
                        <Border Background="{DynamicResource OmniControlBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="DYNAMIC RANGE &amp; SURROUND" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,0,0,8"/>
                                
                                <CheckBox x:Name="ChkNightMode" Content="Night Mode (Dynamic Range Compression - DRC)" Margin="0,3"
                                          Foreground="{DynamicResource OmniForegroundBrush}" Checked="DspOption_Changed" Unchecked="DspOption_Changed"/>

                                <CheckBox x:Name="ChkVoiceNorm" Content="Voice Normalization (Soft Limiter)" Margin="0,3"
                                          Foreground="{DynamicResource OmniForegroundBrush}" Checked="DspOption_Changed" Unchecked="DspOption_Changed"/>

                                <CheckBox x:Name="ChkSurround" Content="3D Spatial Surround Virtualizer (Haas Delay)" Margin="0,3"
                                          Foreground="{DynamicResource OmniForegroundBrush}" Checked="DspOption_Changed" Unchecked="DspOption_Changed"/>
                            </StackPanel>
                        </Border>

                        <!-- Button to open 31-Band Equalizer -->
                        <Button x:Name="BtnOpenFullEq" Content="🎚 Open Full 31-Band Parametric Equalizer Studio..." Click="BtnOpenFullEq_Click"
                                Height="34" FontWeight="SemiBold" Background="{DynamicResource OmniSurfaceBrush}" Foreground="{DynamicResource OmniAccentBrush}" BorderBrush="{DynamicResource OmniBorderBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== 3. SUBTITLES TAB ==================== -->
            <TabItem Header="  💬 Subtitles  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
                    <StackPanel>
                        <!-- Typography & Layout -->
                        <Border Background="{DynamicResource OmniControlBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="FONT SIZE &amp; VERTICAL POSITION" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,0,0,8"/>

                                <!-- Font Size -->
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Font Size:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" FontSize="12"/>
                                    <Slider x:Name="SliderSubFontSize" Grid.Column="1" Minimum="14" Maximum="60" Value="28" SmallChange="1" LargeChange="4"
                                            VerticalAlignment="Center" ValueChanged="SliderSubFontSize_ValueChanged"/>
                                    <TextBlock x:Name="TxtSubFontSizeVal" Grid.Column="2" Text="28 pt" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                </Grid>

                                <!-- Vertical Position -->
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Vertical Margin:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" FontSize="12"/>
                                    <Slider x:Name="SliderSubVerticalPos" Grid.Column="1" Minimum="0" Maximum="140" Value="35" SmallChange="1" LargeChange="5"
                                            VerticalAlignment="Center" ValueChanged="SliderSubVerticalPos_ValueChanged"/>
                                    <TextBlock x:Name="TxtSubVerticalPosVal" Grid.Column="2" Text="35 px" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                </Grid>

                                <!-- Subtitle Color -->
                                <Grid Margin="0,6,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Subtitle Color:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" FontSize="12"/>
                                    <ComboBox x:Name="CmbSubColor" Grid.Column="1" Height="28" SelectionChanged="CmbSubColor_SelectionChanged"
                                              Background="{DynamicResource OmniSurfaceBrush}" Foreground="{DynamicResource OmniForegroundBrush}">
                                        <ComboBoxItem Content="Pure White (#FFFFFF)" Tag="#FFFFFF" IsSelected="True"/>
                                        <ComboBoxItem Content="Golden Yellow (#FFE066)" Tag="#FFE066"/>
                                        <ComboBoxItem Content="Cyan Teal (#66E0FF)" Tag="#66E0FF"/>
                                        <ComboBoxItem Content="Lime Green (#66FF66)" Tag="#66FF66"/>
                                        <ComboBoxItem Content="Vivid Orange (#FFA500)" Tag="#FFA500"/>
                                        <ComboBoxItem Content="Soft Coral (#FF8080)" Tag="#FF8080"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Subtitle Sync Offset Controls -->
                        <Border Background="{DynamicResource OmniControlBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="SUBTITLE SYNCHRONIZATION" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OmniAccentBrush}"/>
                                    <TextBlock x:Name="TxtSyncOffsetVal" Text="Sync Offset: 0 ms" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OmniAccentBrush}"/>
                                </Grid>

                                <UniformGrid Columns="5" Margin="0,4,0,0">
                                    <Button x:Name="BtnSyncMinus500" Content="-500ms" Click="BtnSyncMinus500_Click" Height="28" Margin="2" Background="{DynamicResource OmniSurfaceBrush}"/>
                                    <Button x:Name="BtnSyncMinus50" Content="-50ms" Click="BtnSyncMinus50_Click" Height="28" Margin="2" Background="{DynamicResource OmniSurfaceBrush}"/>
                                    <Button x:Name="BtnSyncReset" Content="Reset" Click="BtnSyncReset_Click" Height="28" Margin="2" FontWeight="SemiBold" Background="{DynamicResource OmniSurfaceBrush}"/>
                                    <Button x:Name="BtnSyncPlus50" Content="+50ms" Click="BtnSyncPlus50_Click" Height="28" Margin="2" Background="{DynamicResource OmniSurfaceBrush}"/>
                                    <Button x:Name="BtnSyncPlus500" Content="+500ms" Click="BtnSyncPlus500_Click" Height="28" Margin="2" Background="{DynamicResource OmniSurfaceBrush}"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Dual Subtitle Toggle -->
                        <Border Background="{DynamicResource OmniControlBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1" Padding="10">
                            <StackPanel>
                                <TextBlock Text="DUAL SUBTITLE RENDERER" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkDualSubtitles" Content="Enable Dual Subtitles (Primary Bottom + Secondary Top)" Margin="0,2"
                                          Foreground="{DynamicResource OmniForegroundBrush}" Checked="ChkDualSubtitles_Changed" Unchecked="ChkDualSubtitles_Changed"/>
                                <TextBlock Text="Renders secondary translated or original audio track at the top of the video surface simultaneously."
                                           FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== 4. PLAYBACK TAB ==================== -->
            <TabItem Header="  ⏯ Playback  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
                    <StackPanel>
                        <!-- Playback Speed Ratio -->
                        <Border Background="{DynamicResource OmniControlBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="PLAYBACK SPEED RATIO (0.2x – 4.0x)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,0,0,8"/>

                                <!-- Speed Slider -->
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Speed:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" FontSize="12"/>
                                    <Slider x:Name="SliderSpeed" Grid.Column="1" Minimum="0.2" Maximum="4.0" Value="1.0" SmallChange="0.05" LargeChange="0.25"
                                            VerticalAlignment="Center" ValueChanged="SliderSpeed_ValueChanged"/>
                                    <TextBlock x:Name="TxtSpeedVal" Grid.Column="2" Text="1.0x (Normal)" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                </Grid>

                                <!-- Speed Presets -->
                                <UniformGrid Columns="4" Margin="0,8,0,0">
                                    <Button x:Name="BtnSpeed05" Content="0.5x" Click="BtnSpeedPreset_Click" Tag="0.5" Height="28" Margin="2" Background="{DynamicResource OmniSurfaceBrush}"/>
                                    <Button x:Name="BtnSpeed10" Content="1.0x" Click="BtnSpeedPreset_Click" Tag="1.0" Height="28" Margin="2" FontWeight="SemiBold" Background="{DynamicResource OmniSurfaceBrush}"/>
                                    <Button x:Name="BtnSpeed15" Content="1.5x" Click="BtnSpeedPreset_Click" Tag="1.5" Height="28" Margin="2" Background="{DynamicResource OmniSurfaceBrush}"/>
                                    <Button x:Name="BtnSpeed20" Content="2.0x" Click="BtnSpeedPreset_Click" Tag="2.0" Height="28" Margin="2" Background="{DynamicResource OmniSurfaceBrush}"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- A-B Repeat Loop -->
                        <Border Background="{DynamicResource OmniControlBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="A-B SEGMENT REPEAT &amp; LOOPING" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,0,0,6"/>
                                
                                <Border Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="4" Padding="8,6" Margin="0,0,0,8" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
                                    <TextBlock x:Name="TxtAbStatus" Text="Loop Status: Inactive" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource OmniAccentBrush}" HorizontalAlignment="Center"/>
                                </Border>

                                <UniformGrid Columns="3">
                                    <Button x:Name="BtnSetA" Content="Set Point [A]" Click="BtnSetA_Click" Height="28" Margin="2" Background="{DynamicResource OmniSurfaceBrush}"/>
                                    <Button x:Name="BtnSetB" Content="Set Point [B]" Click="BtnSetB_Click" Height="28" Margin="2" Background="{DynamicResource OmniSurfaceBrush}"/>
                                    <Button x:Name="BtnClearAB" Content="Clear Loop" Click="BtnClearAB_Click" Height="28" Margin="2" Background="{DynamicResource OmniSurfaceBrush}"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Skip Duration -->
                        <Border Background="{DynamicResource OmniControlBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1" Padding="10">
                            <StackPanel>
                                <TextBlock Text="KEYBOARD JUMP &amp; SKIP DURATION" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,0,0,8"/>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Skip Interval:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" FontSize="12"/>
                                    <ComboBox x:Name="CmbSkipDuration" Grid.Column="1" Height="28" SelectionChanged="CmbSkipDuration_SelectionChanged"
                                              Background="{DynamicResource OmniSurfaceBrush}" Foreground="{DynamicResource OmniForegroundBrush}">
                                        <ComboBoxItem Content="5 Seconds (Default)" Tag="5" IsSelected="True"/>
                                        <ComboBoxItem Content="10 Seconds" Tag="10"/>
                                        <ComboBoxItem Content="30 Seconds" Tag="30"/>
                                        <ComboBoxItem Content="60 Seconds (1 Minute)" Tag="60"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Action Bar / Dismiss -->
        <Border Grid.Row="2" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="8" Padding="12,8" Margin="0,10,0,0" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
            <Grid>
                <TextBlock Text="⚡ Real-time parameters active" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                <Button Content="Close Panel" Click="BtnClose_Click" HorizontalAlignment="Right" Width="95" Height="28" Background="{DynamicResource OmniControlBackgroundBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
