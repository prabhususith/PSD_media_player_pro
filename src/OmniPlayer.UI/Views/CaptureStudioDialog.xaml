<Window x:Class="OmniPlayer.UI.Views.CaptureStudioDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture Studio &amp; Frame Grabber"
        Height="540" Width="750"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource OmniBackgroundBrush}"
        Foreground="{DynamicResource OmniForegroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="CAPTURE STUDIO &amp; ANIMATED GIF GENERATOR" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource OmniAccentBrush}"/>
                <TextBlock Text="High-precision frame grabs, continuous burst sequence capture, and GIF rendering" FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Background="{DynamicResource OmniSurfaceBrush}" BorderBrush="{DynamicResource OmniBorderBrush}">
            <!-- Tab 1: Single Frame Grab -->
            <TabItem Header="Single Frame Screenshot">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Save Current Video Frame:" FontWeight="SemiBold" Foreground="{DynamicResource OmniForegroundBrush}"/>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,12">
                        <TextBlock Text="Image Format:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,0,12,0"/>
                        <RadioButton x:Name="RbPng" Content="Lossless PNG" IsChecked="True" Foreground="{DynamicResource OmniForegroundBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <RadioButton x:Name="RbWebp" Content="Modern WebP" Foreground="{DynamicResource OmniForegroundBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <RadioButton x:Name="RbBmp" Content="Raw BMP 24-bit" Foreground="{DynamicResource OmniForegroundBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <CheckBox x:Name="ChkIncludeSubtitles" Grid.Row="2" Content="Burn active subtitles into captured frame" IsChecked="True" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,0,0,12"/>

                    <Border Grid.Row="3" Background="{DynamicResource OmniControlBackgroundBrush}" CornerRadius="6" Padding="12">
                        <TextBlock Text="Captures zero-copy frame buffer directly from Direct3D 11 surface at native media resolution (up to 8K HDR)." TextWrapping="Wrap" Foreground="{DynamicResource OmniMutedForegroundBrush}" VerticalAlignment="Center"/>
                    </Border>

                    <Button Grid.Row="4" Content="Capture &amp; Save Frame..." Click="BtnCaptureFrame_Click" Height="36" FontWeight="SemiBold" Background="{DynamicResource OmniAccentBrush}" Foreground="#FFFFFF" BorderThickness="0" Margin="0,16,0,0"/>
                </Grid>
            </TabItem>

            <!-- Tab 2: Frame Burst -->
            <TabItem Header="Continuous Burst Mode">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Rapid Burst Sequence Capture:" FontWeight="SemiBold" Foreground="{DynamicResource OmniForegroundBrush}"/>

                    <Grid Grid.Row="1" Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Frame Count:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,4"/>
                        <ComboBox x:Name="CmbBurstCount" Grid.Column="1" Height="28" Width="140" HorizontalAlignment="Left" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,4">
                            <ComboBoxItem Content="5 Consecutive Frames"/>
                            <ComboBoxItem Content="10 Consecutive Frames" IsSelected="True"/>
                            <ComboBoxItem Content="25 Consecutive Frames"/>
                            <ComboBoxItem Content="50 Consecutive Frames"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Text="Interval between frames:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,8,0,4"/>
                        <ComboBox x:Name="CmbBurstInterval" Grid.Row="1" Grid.Column="1" Height="28" Width="140" HorizontalAlignment="Left" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,8,0,4">
                            <ComboBoxItem Content="Every 1 Frame (Native FPS)" IsSelected="True"/>
                            <ComboBoxItem Content="Every 5 Frames"/>
                            <ComboBoxItem Content="Every 100ms"/>
                            <ComboBoxItem Content="Every 500ms"/>
                            <ComboBoxItem Content="Every 1.0 Second"/>
                        </ComboBox>
                    </Grid>

                    <Border Grid.Row="3" Background="{DynamicResource OmniControlBackgroundBrush}" CornerRadius="6" Padding="12">
                        <TextBlock Text="Sequential frames will be saved automatically with sequential numbered filenames into the target capture directory." TextWrapping="Wrap" Foreground="{DynamicResource OmniMutedForegroundBrush}" VerticalAlignment="Center"/>
                    </Border>

                    <Button Grid.Row="4" Content="Start Continuous Burst Capture..." Click="BtnBurstCapture_Click" Height="36" FontWeight="SemiBold" Background="{DynamicResource OmniAccentBrush}" Foreground="#FFFFFF" BorderThickness="0" Margin="0,16,0,0"/>
                </Grid>
            </TabItem>

            <!-- Tab 3: Animated GIF Generator -->
            <TabItem Header="Animated GIF Generator">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Create Animated GIF from Video Timeline Bounds:" FontWeight="SemiBold" Foreground="{DynamicResource OmniForegroundBrush}"/>

                    <Grid Grid.Row="1" Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Start (In-Point):" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                        <TextBox x:Name="TxtInPoint" Grid.Column="1" Text="00:00:10.000" Height="28" VerticalContentAlignment="Center" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}"/>

                        <TextBlock Grid.Column="3" Text="End (Out-Point):" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                        <TextBox x:Name="TxtOutPoint" Grid.Column="4" Text="00:00:15.000" Height="28" VerticalContentAlignment="Center" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Target FPS:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,0,10,0"/>
                        <ComboBox x:Name="CmbGifFps" Width="100" Height="28" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,0,24,0">
                            <ComboBoxItem Content="15 FPS"/>
                            <ComboBoxItem Content="24 FPS" IsSelected="True"/>
                            <ComboBoxItem Content="30 FPS"/>
                            <ComboBoxItem Content="60 FPS"/>
                        </ComboBox>

                        <TextBlock Text="Width Scaling:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,0,10,0"/>
                        <ComboBox x:Name="CmbGifScale" Width="130" Height="28" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}">
                            <ComboBoxItem Content="480p (Fast)"/>
                            <ComboBoxItem Content="720p HD" IsSelected="True"/>
                            <ComboBoxItem Content="1080p Full HD"/>
                            <ComboBoxItem Content="Original Size"/>
                        </ComboBox>
                    </StackPanel>

                    <Border Grid.Row="3" Background="{DynamicResource OmniControlBackgroundBrush}" CornerRadius="6" Padding="12">
                        <TextBlock Text="Uses high-fidelity Floyd-Steinberg dithering with adaptive color palette generation for artifact-free GIF loops." TextWrapping="Wrap" Foreground="{DynamicResource OmniMutedForegroundBrush}" VerticalAlignment="Center"/>
                    </Border>

                    <Button Grid.Row="4" Content="Generate Animated GIF..." Click="BtnGenerateGif_Click" Height="36" FontWeight="SemiBold" Background="{DynamicResource OmniAccentBrush}" Foreground="#FFFFFF" BorderThickness="0" Margin="0,16,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="8" Padding="10" Margin="0,12,0,0" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
            <TextBlock x:Name="TxtStatus" Text="Ready to capture frames from media surface." VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" FontSize="11"/>
        </Border>
    </Grid>
</Window>
