<Window x:Class="OmniPlayer.UI.Views.MediaLibraryDashboardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PSD Media Player - Device Media Library &amp; Auto-Scan Dashboard"
        Height="720" Width="1060"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource OmniBackgroundBrush}"
        Foreground="{DynamicResource OmniForegroundBrush}">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource OmniControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OmniForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OmniBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Metrics Ribbon -->
            <RowDefinition Height="Auto"/> <!-- Filter & Search Bar -->
            <RowDefinition Height="*"/>    <!-- Library Content Tabs -->
            <RowDefinition Height="Auto"/> <!-- Status Footer -->
        </Grid.RowDefinitions>

        <!-- Top Title & Metrics Ribbon -->
        <Border Grid.Row="0" Margin="0,0,0,12" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="8" Padding="14,10" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📚 DEVICE MEDIA LIBRARY &amp; DASHBOARD" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource OmniAccentBrush}"/>
                    <Border Background="#2600E5FF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AUTO-SCANNER READY" FontSize="10" FontWeight="Bold" Foreground="#00E5FF"/>
                    </Border>
                </StackPanel>

                <!-- Metrics Summary Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Total Videos -->
                    <Border Background="{DynamicResource OmniControlBackgroundBrush}" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎬 Videos: " FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                            <TextBlock x:Name="TxtTotalVideos" Text="0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource OmniForegroundBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Music -->
                    <Border Background="{DynamicResource OmniControlBackgroundBrush}" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎵 Music: " FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                            <TextBlock x:Name="TxtTotalMusic" Text="0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource OmniForegroundBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Storage -->
                    <Border Background="{DynamicResource OmniControlBackgroundBrush}" CornerRadius="6" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾 Storage: " FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                            <TextBlock x:Name="TxtTotalStorage" Text="0 MB" FontSize="12" FontWeight="Bold" Foreground="#00FF9D"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Rescan and Add Folder Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRescan" Content="🔄 Rescan Device" Click="BtnRescan_Click" Height="32" FontWeight="SemiBold" Background="{DynamicResource OmniAccentBrush}" Foreground="#FFFFFF" BorderThickness="0" Margin="0,0,8,0"/>
                    <Button Content="📁 Add Folder..." Click="BtnAddFolder_Click" Height="32"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search & Quick Filter Bar -->
        <Border Grid.Row="1" Margin="0,0,0,12" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="8" Padding="10,8" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="🔍 Filter Media:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="4,0,10,0"/>

                <TextBox x:Name="TxtSearchFilter" Grid.Column="1" Height="32" Padding="8,5" VerticalAlignment="Center"
                         Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}"
                         BorderBrush="{DynamicResource OmniBorderBrush}" TextChanged="TxtSearchFilter_TextChanged"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Content="All" Click="BtnFilterType_Click" Tag="All" Margin="0,0,4,0"/>
                    <Button Content="Videos" Click="BtnFilterType_Click" Tag="Video" Margin="0,0,4,0"/>
                    <Button Content="Music" Click="BtnFilterType_Click" Tag="Audio" Margin="0,0,4,0"/>
                    <Button Content="Images" Click="BtnFilterType_Click" Tag="Image"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Library Content Tabs -->
        <TabControl Grid.Row="2" Background="{DynamicResource OmniSurfaceBrush}" BorderBrush="{DynamicResource OmniBorderBrush}">
            <!-- TAB 1: ALL DISCOVERED MEDIA -->
            <TabItem Header="  All Discovered Media  ">
                <DataGrid x:Name="DataGridAllMedia" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" Foreground="{DynamicResource OmniForegroundBrush}"
                          BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          SelectionMode="Single" RowHeight="36" AlternatingRowBackground="#0AFFFFFF"
                          MouseDoubleClick="DataGridMedia_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="80"/>
                        <DataGridTextColumn Header="Media Title" Binding="{Binding Title}" Width="3*"/>
                        <DataGridTextColumn Header="Format" Binding="{Binding Extension}" Width="80"/>
                        <DataGridTextColumn Header="File Size" Binding="{Binding FormattedSize}" Width="100"/>
                        <DataGridTextColumn Header="Directory Path" Binding="{Binding DirectoryPath}" Width="3*"/>
                        <DataGridTemplateColumn Header="Action" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="▶ Play" Click="BtnPlayItem_Click" Tag="{Binding FilePath}"
                                            Background="{DynamicResource OmniAccentBrush}" Foreground="#FFFFFF"
                                            BorderThickness="0" Height="26" Padding="8,0" FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- TAB 2: VIDEOS -->
            <TabItem Header="  Video Library  ">
                <DataGrid x:Name="DataGridVideos" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" Foreground="{DynamicResource OmniForegroundBrush}"
                          BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          SelectionMode="Single" RowHeight="36" AlternatingRowBackground="#0AFFFFFF"
                          MouseDoubleClick="DataGridMedia_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Video Title" Binding="{Binding Title}" Width="4*"/>
                        <DataGridTextColumn Header="Codec/Format" Binding="{Binding Extension}" Width="110"/>
                        <DataGridTextColumn Header="File Size" Binding="{Binding FormattedSize}" Width="110"/>
                        <DataGridTextColumn Header="Location" Binding="{Binding DirectoryPath}" Width="3*"/>
                        <DataGridTemplateColumn Header="Action" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="▶ Play" Click="BtnPlayItem_Click" Tag="{Binding FilePath}"
                                            Background="{DynamicResource OmniAccentBrush}" Foreground="#FFFFFF"
                                            BorderThickness="0" Height="26" Padding="8,0" FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- TAB 3: MUSIC & AUDIO -->
            <TabItem Header="  Music &amp; Audio Tracks  ">
                <DataGrid x:Name="DataGridAudio" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" Foreground="{DynamicResource OmniForegroundBrush}"
                          BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          SelectionMode="Single" RowHeight="36" AlternatingRowBackground="#0AFFFFFF"
                          MouseDoubleClick="DataGridMedia_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Track Title" Binding="{Binding Title}" Width="4*"/>
                        <DataGridTextColumn Header="Audio Format" Binding="{Binding Extension}" Width="110"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="110"/>
                        <DataGridTextColumn Header="Location" Binding="{Binding DirectoryPath}" Width="3*"/>
                        <DataGridTemplateColumn Header="Action" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="▶ Play" Click="BtnPlayItem_Click" Tag="{Binding FilePath}"
                                            Background="{DynamicResource OmniAccentBrush}" Foreground="#FFFFFF"
                                            BorderThickness="0" Height="26" Padding="8,0" FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- Status & Playback Action Footer -->
        <Border Grid.Row="3" Margin="0,12,0,0" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="6" Padding="12,8" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="TxtFooterStatus" Text="Ready: Double-click any track or click '▶ Play' to launch in PSD Media Player." FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="📂 Open Selected Folder" Click="BtnOpenSelectedFolder_Click" Height="28" Margin="0,0,8,0"/>
                    <Button Content="Close" Click="BtnClose_Click" Height="28" Width="70"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
