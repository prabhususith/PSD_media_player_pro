<Window x:Class="OmniPlayer.UI.Views.EqualizerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PSD Media Player - Audio DSP &amp; Equalizer Studio"
        Height="700" Width="1000"
        MinHeight="640" MinWidth="880"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource OmniBackgroundBrush}"
        Foreground="{DynamicResource OmniForegroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Presets -->
            <RowDefinition Height="Auto"/> <!-- Preamp -->
            <RowDefinition Height="*"/>    <!-- Bands -->
            <RowDefinition Height="Auto"/> <!-- Next-Gen Audio DSP Controls -->
            <RowDefinition Height="Auto"/> <!-- Footer / Passthrough -->
        </Grid.RowDefinitions>

        <!-- Top Header & Presets Bar -->
        <Border Grid.Row="0" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="PRESET:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                <ComboBox x:Name="CmbPresets" Grid.Column="1" SelectionChanged="CmbPresets_SelectionChanged" Height="30" VerticalContentAlignment="Center" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkEqEnable" Content="EQ Active" IsChecked="True" Checked="ChkEqEnable_Changed" Unchecked="ChkEqEnable_Changed" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,0,15,0"/>
                    <RadioButton x:Name="Rb10Band" Content="10-Band" IsChecked="True" Checked="BandMode_Changed" Foreground="{DynamicResource OmniForegroundBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <RadioButton x:Name="Rb31Band" Content="31-Band (1/3 Octave ISO)" Checked="BandMode_Changed" Foreground="{DynamicResource OmniForegroundBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="4" Content="Reset EQ" Click="BtnReset_Click" Width="85" Height="30" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}"/>
            </Grid>
        </Border>

        <!-- Preamp Bar -->
        <Border Grid.Row="1" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="65"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Pre-Amp:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                <Slider x:Name="SliderPreamp" Grid.Column="1" Minimum="-20" Maximum="20" Value="0" ValueChanged="SliderPreamp_ValueChanged" VerticalAlignment="Center" SmallChange="0.5" LargeChange="2"/>
                <TextBlock x:Name="TxtPreampVal" Grid.Column="2" Text="0.0 dB" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource OmniAccentBrush}"/>
            </Grid>
        </Border>

        <!-- Band Sliders Container (Scrollable for 31 bands) -->
        <Border Grid.Row="2" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PanelBands" Orientation="Horizontal" HorizontalAlignment="Center"/>
            </ScrollViewer>
        </Border>

        <!-- Next-Gen Sound Technologies & Acoustic Processing -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: 3D Sound Technologies -->
            <Border Grid.Column="0" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="8" Padding="10" Margin="0,0,6,0" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🌌 3D SOUND TECHNOLOGIES" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Spatial Engine Mode:" FontSize="10" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbSoundTechnology" SelectionChanged="CmbSoundTechnology_SelectionChanged" Height="28" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,0,0,8"/>

                    <CheckBox x:Name="ChkSurround" Content="Haas Spatial Surround" Checked="DspOption_Changed" Unchecked="DspOption_Changed" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,2,0,4" FontSize="11"/>
                    <CheckBox x:Name="ChkNightMode" Content="Night Mode (DRC Limiter)" Checked="DspOption_Changed" Unchecked="DspOption_Changed" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,2,0,0" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Room Echo & Reverb Presets -->
            <Border Grid.Column="1" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="8" Padding="10" Margin="3,0,3,0" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🏛 ROOM ACOUSTICS &amp; REVERB" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Acoustic Environment Preset:" FontSize="10" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbRoomEcho" SelectionChanged="CmbRoomEcho_SelectionChanged" Height="28" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,0,0,8"/>

                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Wet Mix:" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                        <Slider x:Name="SliderReverbWet" Grid.Column="1" Minimum="0" Maximum="100" Value="25" SmallChange="1" LargeChange="10" ValueChanged="SliderReverbWet_ValueChanged" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtReverbWetVal" Grid.Column="2" Text="25%" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource OmniForegroundBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 3: Pitch Tuning & Vocal FX -->
            <Border Grid.Column="2" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="8" Padding="10" Margin="6,0,0,0" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🎵 PITCH &amp; VOCAL STUDIO" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,0,0,6"/>

                    <!-- Pitch Tuning Slider & Reset -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Pitch:" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                        <Slider x:Name="SliderPitch" Grid.Column="1" Minimum="-12" Maximum="12" Value="0" SmallChange="1" LargeChange="3" ValueChanged="SliderPitch_ValueChanged" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtPitchVal" Grid.Column="2" Text="0 st" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,0,4,0"/>
                        <Button x:Name="BtnResetPitch" Grid.Column="3" Content="0" Click="BtnResetPitch_Click" Height="22" Width="26" FontSize="10" ToolTip="Reset Pitch to 0 Semitones" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}"/>
                    </Grid>

                    <CheckBox x:Name="ChkKaraoke" Content="🎤 Karaoke Vocal Remover" Checked="DspOption_Changed" Unchecked="DspOption_Changed" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,2,0,4" FontSize="11"/>
                    <CheckBox x:Name="ChkDialogueClarity" Content="🗣 Smart Dialogue Enhancer" Checked="DspOption_Changed" Unchecked="DspOption_Changed" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,2,0,0" FontSize="11"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom Passthrough & System Settings -->
        <Border Grid.Row="4" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="8" Padding="12,8" Margin="0,10,0,0" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkVoiceNorm" Content="Voice Normalization" Checked="DspOption_Changed" Unchecked="DspOption_Changed" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,0,20,0"/>
                    <CheckBox x:Name="ChkPitchPreserve" Content="Pitch Preserver (SOLA)" IsChecked="True" Checked="DspOption_Changed" Unchecked="DspOption_Changed" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,0,20,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="WASAPI Bitstream Passthrough:" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,0,8,0" FontWeight="SemiBold" FontSize="11"/>
                    <ComboBox x:Name="CmbPassthrough" SelectionChanged="CmbPassthrough_SelectionChanged" Width="180" Height="28" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
