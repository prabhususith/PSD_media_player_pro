<Window x:Class="OmniPlayer.UI.Views.HelpGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PSD Media Player - Interactive Help &amp; Master User Guide"
        Height="730" Width="1020"
        MinHeight="580" MinWidth="880"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource OmniBackgroundBrush}"
        Foreground="{DynamicResource OmniForegroundBrush}"
        FontFamily="Segoe UI, Inter, Roboto, sans-serif">

    <Window.Resources>
        <!-- Nav Sidebar Item Button Style -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource OmniForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="navBorder" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="3,0,0,0"
                                CornerRadius="6" Margin="4,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="{DynamicResource OmniControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="navBorder" Property="Background" Value="{DynamicResource OmniControlBackgroundBrush}"/>
                                <Setter TargetName="navBorder" Property="BorderBrush" Value="{DynamicResource OmniAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Topic Card Container Style -->
        <Style x:Key="GuideCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource OmniControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OmniBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Key Pill Style -->
        <Style x:Key="KeyPillBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource OmniSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OmniAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Master Header -->
            <RowDefinition Height="*"/>    <!-- Sidebar & Content -->
            <RowDefinition Height="Auto"/> <!-- Status Footer -->
        </Grid.RowDefinitions>

        <!-- ==================== MASTER TOP HEADER ==================== -->
        <Border Grid.Row="0" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,10"
                BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Branding Badge -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🚀" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="PSD MEDIA PLAYER PRO" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource OmniAccentBrush}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource OmniControlBackgroundBrush}" BorderBrush="{DynamicResource OmniAccentBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v2.5.0 LTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OmniAccentBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Interactive Help &amp; Master User Guide • Architecture, Shortcuts &amp; DSP Manual" FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="28,2,0,0"/>
                </StackPanel>

                <!-- Search Input Box -->
                <Grid Grid.Column="1" Margin="20,0,16,0" VerticalAlignment="Center" MaxWidth="440" HorizontalAlignment="Stretch">
                    <TextBox x:Name="TxtSearchGuide" Height="34" FontSize="13" Padding="10,6,28,6" VerticalContentAlignment="Center"
                             Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}"
                             BorderBrush="{DynamicResource OmniBorderBrush}" TextChanged="TxtSearchGuide_TextChanged"/>
                    <TextBlock x:Name="TxtSearchPlaceholder" Text="🔍 Search topics, IPTV, audio DSP, shortcuts..."
                               FontSize="12" Foreground="{DynamicResource OmniMutedForegroundBrush}"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Button x:Name="BtnClearSearch" Content="✕" Click="BtnClearSearch_Click" Width="24" Height="24"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource OmniMutedForegroundBrush}"
                            Visibility="Collapsed" Cursor="Hand"/>
                </Grid>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnQuickShortcuts" Content="⌨️ Shortcuts" Click="BtnQuickShortcuts_Click"
                            Height="32" Padding="10,0" Margin="0,0,6,0" FontWeight="SemiBold"
                            Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}"
                            BorderBrush="{DynamicResource OmniBorderBrush}"/>
                    <Button x:Name="BtnQuickAbout" Content="ℹ️ About" Click="BtnQuickAbout_Click"
                            Height="32" Padding="10,0" FontWeight="SemiBold"
                            Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}"
                            BorderBrush="{DynamicResource OmniBorderBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== BODY (SIDEBAR & TAB CONTENTS) ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/> <!-- Nav Sidebar -->
                <ColumnDefinition Width="*"/>   <!-- Content Canvas -->
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="8"
                    BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1" Margin="0,0,10,0" Padding="4,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SidebarButtonContainer">
                        <TextBlock Text="NAVIGATION TOPICS" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="12,8,0,6"/>

                        <!-- Tab 1: Quick Start -->
                        <Button x:Name="NavTab1" Style="{StaticResource SidebarNavButtonStyle}" Click="NavTab_Click" Tag="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🚀" FontSize="16" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Quick Start &amp; Views" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                    <TextBlock Text="4 View Modes, Media Opening" FontSize="10" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Tab 2: IPTV & Live Channels -->
                        <Button x:Name="NavTab2" Style="{StaticResource SidebarNavButtonStyle}" Click="NavTab_Click" Tag="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📺" FontSize="16" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Global IPTV &amp; Live TV" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                    <TextBlock Text="1000+ Channels, GitHub Sync" FontSize="10" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Tab 3: Sound Technologies & DSP -->
                        <Button x:Name="NavTab3" Style="{StaticResource SidebarNavButtonStyle}" Click="NavTab_Click" Tag="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🎧" FontSize="16" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Sound Tech &amp; Audio DSP" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                    <TextBlock Text="Dolby Atmos, DTS:X, 31-Band EQ" FontSize="10" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Tab 4: Speed & Video Controls -->
                        <Button x:Name="NavTab4" Style="{StaticResource SidebarNavButtonStyle}" Click="NavTab_Click" Tag="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="⏩" FontSize="16" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Speed &amp; Video Controls" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                    <TextBlock Text="0.1x-4.0x, Frame Step, D3D11VA" FontSize="10" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Tab 5: Recording & Snapshot Studio -->
                        <Button x:Name="NavTab5" Style="{StaticResource SidebarNavButtonStyle}" Click="NavTab_Click" Tag="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📹" FontSize="16" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Recording &amp; Snapshot" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                    <TextBlock Text="1-Click Telecast MP4, Burst, GIF" FontSize="10" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Tab 6: Online Video Downloader -->
                        <Button x:Name="NavTab6" Style="{StaticResource SidebarNavButtonStyle}" Click="NavTab_Click" Tag="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="⬇️" FontSize="16" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Online Video Downloader" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                    <TextBlock Text="YouTube, X, Insta, yt-dlp" FontSize="10" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Tab 7: Master Shortcuts Cheatsheet -->
                        <Button x:Name="NavTab7" Style="{StaticResource SidebarNavButtonStyle}" Click="NavTab_Click" Tag="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="⌨️" FontSize="16" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Keyboard Shortcuts Grid" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                    <TextBlock Text="Searchable Cheatsheet (40+ Keys)" FontSize="10" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Tab 8: About PSD Media Player Pro -->
                        <Button x:Name="NavTab8" Style="{StaticResource SidebarNavButtonStyle}" Click="NavTab_Click" Tag="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ℹ️" FontSize="16" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="About PSD Media Player" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                    <TextBlock Text="Engine Architecture &amp; Credits" FontSize="10" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Main Content Display -->
            <Border Grid.Column="1" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="8"
                    BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1" Padding="16,14">
                <Grid>
                    <!-- Search Results Overlay (Visible when search text is active) -->
                    <Grid x:Name="PanelSearchResults" Visibility="Collapsed" Panel.ZIndex="10" Background="{DynamicResource OmniSurfaceBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource OmniControlBackgroundBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                                BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtSearchResultCount" Text="Matching topics found:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ItemsSearchResults">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GuideCardStyle}" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonUp="SearchResultItem_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource OmniAccentBrush}"/>
                                                        <Border Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="3" Padding="6,1" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Snippet}" FontSize="11" Foreground="{DynamicResource OmniForegroundBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="Jump ➔" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource OmniAccentBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- TabControl (Header collapsed, navigated via Sidebar) -->
                    <TabControl x:Name="GuideTabControl" Background="Transparent" BorderThickness="0" Padding="0">
                        <TabControl.ItemContainerStyle>
                            <Style TargetType="TabItem">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </TabControl.ItemContainerStyle>

                        <!-- ==================== TAB 1: QUICK START & VIEW MODES ==================== -->
                        <TabItem>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="🚀 Quick Start &amp; View Modes" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Master the 4 dynamic player view modes, media loading pipelines, and instant timeline seeking." FontSize="12" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,0,0,16"/>

                                    <!-- 4 Dynamic View Modes -->
                                    <Border Style="{StaticResource GuideCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="THE 4 DYNAMIC VIEW MODES" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,0,0,10"/>
                                            <TextBlock Text="PSD Media Player Pro adapts dynamically to your workflow with 4 specialized viewing archetypes. Cycle through them instantly by pressing V or F8." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,0,0,12"/>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Mode 1: Basic -->
                                                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="6" Padding="10" Margin="0,0,6,8" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🟢 Basic Mode" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                                            <Border Style="{StaticResource KeyPillBorder}" Margin="8,0,0,0">
                                                                <TextBlock Text="Ctrl + 1" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OmniAccentBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="Pure borderless video canvas with title bar and menus hidden. Designed for uninterrupted immersive movie watching and projector setups. Press H to toggle controls." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Mode 2: Normal -->
                                                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="6" Padding="10" Margin="6,0,0,8" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🔵 Normal Mode" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                                            <Border Style="{StaticResource KeyPillBorder}" Margin="8,0,0,0">
                                                                <TextBlock Text="Ctrl + 2" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OmniAccentBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="Standard desktop workstation layout with top menu bar, volume slider, time tracking, speed controls, and status bar. The familiar default player experience." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Mode 3: Advanced -->
                                                <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="6" Padding="10" Margin="0,0,6,0" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🟣 Advanced Studio HUD" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                                            <Border Style="{StaticResource KeyPillBorder}" Margin="8,0,0,0">
                                                                <TextBlock Text="Ctrl + 3" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OmniAccentBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="Studio broadcast telemetry display showing live Direct3D 11 hardware decoding stats, FPS gauge, buffer latency, dropped frame counters, and audio channel meters." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Mode 4: Modern -->
                                                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="6" Padding="10" Margin="6,0,0,0" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🟠 Modern Glass HUD" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                                            <Border Style="{StaticResource KeyPillBorder}" Margin="8,0,0,0">
                                                                <TextBlock Text="Ctrl + 4" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OmniAccentBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="Futuristic acrylic and mica translucent floating controls that automatically fade out on mouse inactivity. Sleek neon seek pill with rounded glowing accents." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Opening Files, Discs & Streams -->
                                    <Border Style="{StaticResource GuideCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="OPENING MEDIA &amp; DRAG-AND-DROP" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,0,0,8"/>
                                            <TextBlock Text="• Drag-and-Drop: Simply drag any video file, audio track, folder, or playlist (.m3u, .pls) directly onto the player window to start instant playback." FontSize="11" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,2,0,4"/>
                                            <TextBlock Text="• Local Files (Ctrl+O): Open single or multiple files with native Windows File Dialog." FontSize="11" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,2,0,4"/>
                                            <TextBlock Text="• Disc Playback: Play DVD-Video, Blu-ray ISO images, and Audio CDs with full interactive menu and chapter support." FontSize="11" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,2,0,4"/>
                                            <TextBlock Text="• Network Streams (Ctrl+U): Stream direct HTTP/HTTPS URLs, YouTube links, HLS (.m3u8), DASH (.mpd), and RTSP camera feeds." FontSize="11" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,2,0,4"/>
                                            <TextBlock Text="• Subtitle Drag-and-Drop: Drop any .srt, .ass, or .vtt file during playback to load secondary or dual bilingual subtitles instantly." FontSize="11" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Quick Seeking & Jump Keys -->
                                    <Border Style="{StaticResource GuideCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="PRECISION SEEKING &amp; NAVIGATION" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,0,0,8"/>
                                            <TextBlock Text="• Number Keys 0 to 9: Jump instantly to percentage milestones (0 = 0% Start, 5 = 50% Midpoint, 9 = 90% Climax)." FontSize="11" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,2,0,4"/>
                                            <TextBlock Text="• Arrow Keys: Left/Right jumps 5s; Shift+Left/Right jumps 1s (fine seek); Ctrl+Left/Right jumps 30s." FontSize="11" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,2,0,4"/>
                                            <TextBlock Text="• YouTube J/L Keys: Press J to rewind 10s, or L to fast-forward 10s with real-time OSD bubble." FontSize="11" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ==================== TAB 2: GLOBAL IPTV & LIVE CHANNELS ==================== -->
                        <TabItem>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="📺 Global IPTV &amp; Live Channels Hub" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Browse 1,000+ free high-definition television stations across India and worldwide." FontSize="12" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,0,0,16"/>

                                    <Border Style="{StaticResource GuideCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="ACCESSING THE 1000+ CHANNEL HUB" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,0,0,8"/>
                                            <TextBlock Text="Press Ctrl+L or select View -> Live TV Hub (1000+ Channels) to open the interactive station directory. The hub features high-speed fuzzy search, category filter pills, channel logo previews, and stream resolution indicators." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource OmniForegroundBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Indian Regional Channels -->
                                    <Border Style="{StaticResource GuideCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="COMPREHENSIVE INDIAN REGIONAL COVERAGE" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,0,0,8"/>
                                            <TextBlock Text="The IPTV engine contains verified live streams for all major Indian languages and broadcast regions:" FontSize="11" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,0,0,8"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="• Tamil: Sun News, Polimer, Puthiya Thalaimurai, News7, Thanthi TV, Kalaignar, Jaya Plus" FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,2"/>
