<Window x:Class="OmniPlayer.UI.Views.MediaInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Stream Information &amp; Hardware Diagnostics"
        Height="500" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource OmniBackgroundBrush}"
        Foreground="{DynamicResource OmniForegroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="ACTIVE MEDIA TELEMETRY &amp; HARDWARE SURFACE" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource OmniAccentBrush}"/>
                <TextBlock Text="Real-time frame pipeline counters, bitrate, chroma subsampling, and decoder specs" FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Container Format:" FontWeight="SemiBold" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Matroska (MKV) / MP4 Pro Stream" FontWeight="Bold" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Video Codec:" FontWeight="SemiBold" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="HEVC / H.265 Main 10 Profile (10-bit HDR)" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Resolution &amp; Aspect Ratio:" FontWeight="SemiBold" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="3840 x 2160 (16:9 UHD 4K)" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,4"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Nominal &amp; Actual Framerate:" FontWeight="SemiBold" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="59.940 fps (V-Sync Locked)" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,4"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Chroma Subsampling &amp; Depth:" FontWeight="SemiBold" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,4"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="YUV 4:2:0 (10-bit Rec.2020 PQ / HDR10)" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,4"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Video Bitrate (Instantaneous):" FontWeight="SemiBold" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,4"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="42,850 kbps (Peak: 68,200 kbps)" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,4"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Hardware Acceleration Backend:" FontWeight="SemiBold" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,4"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TxtDecoderBackend" Text="Direct3D 11 Video Acceleration (D3D11VA Zero-Copy)" FontWeight="Bold" Foreground="{DynamicResource OmniAccentBrush}" Margin="0,4"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Frame Drops / Late Frames:" FontWeight="SemiBold" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,4"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="0 dropped / 0 late (Jitter: 0.12 ms)" Foreground="#10B981" FontWeight="Bold" Margin="0,4"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Audio Stream Specs:" FontWeight="SemiBold" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,4"/>
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="Dolby Atmos / TrueHD 7.1ch (48000 Hz, 24-bit, 4608 kbps)" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,4"/>

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Active Subtitle Engine:" FontWeight="SemiBold" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,4"/>
                    <TextBlock Grid.Row="9" Grid.Column="1" Text="libass / SSA Advanced Substation Alpha Vector Renderer" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,4"/>

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="DirectX Swapchain Presentation:" FontWeight="SemiBold" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,4"/>
                    <TextBlock Grid.Row="10" Grid.Column="1" Text="DXGI_SWAP_EFFECT_FLIP_DISCARD (16-bit Float scRGB)" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,4"/>

                    <TextBlock Grid.Row="11" Grid.Column="0" Text="RAM Cache Status:" FontWeight="SemiBold" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,4"/>
                    <TextBlock Grid.Row="11" Grid.Column="1" Text="256 MB Allocated / 242 MB Pre-buffered (94.5% fill)" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,4"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="8" Padding="10" Margin="0,12,0,0" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1">
            <Grid>
                <TextBlock Text="Diagnostics updated dynamically at 60Hz." VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedForegroundBrush}" FontSize="11"/>
                <Button Content="Copy Diagnostics" Click="BtnCopy_Click" HorizontalAlignment="Right" Width="130" Height="28" Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
