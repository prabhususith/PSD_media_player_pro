<Window x:Class="OmniPlayer.UI.Views.MediaDownloaderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PSD Media Player - Online Media &amp; Video Downloader"
        Height="700" Width="820"
        MinHeight="560" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource OmniBackgroundBrush}"
        Foreground="{DynamicResource OmniForegroundBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- URL Input & Quick Links -->
            <RowDefinition Height="Auto"/> <!-- Format & Destination Path -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons & Status -->
            <RowDefinition Height="Auto"/> <!-- Progress & Metrics HUD -->
            <RowDefinition Height="*"/>    <!-- Completed Downloads List -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,14" Padding="0,0,0,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource OmniBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📥" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="PSD Media Player - Online Media &amp; Video Downloader" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource OmniAccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Supports YouTube, Twitter/X, Instagram, TikTok, Facebook, direct HLS (.m3u8), and direct MP4/MKV video streams."
                               FontSize="12" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="30,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" x:Name="BadgeEngine" Background="{DynamicResource OmniSurfaceBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtEngineBadge" Text="⚡ Engine: Initializing..." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OmniAccentBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- URL Input & Presets -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="Online Media / Stream URL:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtUrl" Height="36" FontSize="13" Padding="10,8" VerticalContentAlignment="Center"
                         Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}"
                         BorderBrush="{DynamicResource OmniBorderBrush}"/>

                <Button Grid.Column="1" Content="📋 Paste" Click="BtnPaste_Click"
                        Height="36" Padding="12,0" Margin="8,0,0,0"
                        Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}"
                        BorderBrush="{DynamicResource OmniBorderBrush}"/>

                <Button Grid.Column="2" Content="✕ Clear" Click="BtnClear_Click"
                        Height="36" Padding="10,0" Margin="6,0,0,0"
                        Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}"
                        BorderBrush="{DynamicResource OmniBorderBrush}"/>
            </Grid>

            <!-- Quick sample/platform chips -->
            <WrapPanel Margin="0,2,0,0">
                <TextBlock Text="Supported:" FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                <Button Content="YouTube" Click="QuickChip_Click" Tag="https://www.youtube.com/watch?v=aqz-KE-bpKQ" Height="22" Padding="6,0" Margin="0,0,4,4" FontSize="10" Background="{DynamicResource OmniSurfaceBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}"/>
                <Button Content="Twitter / X" Click="QuickChip_Click" Tag="https://twitter.com" Height="22" Padding="6,0" Margin="0,0,4,4" FontSize="10" Background="{DynamicResource OmniSurfaceBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}"/>
                <Button Content="TikTok" Click="QuickChip_Click" Tag="https://www.tiktok.com" Height="22" Padding="6,0" Margin="0,0,4,4" FontSize="10" Background="{DynamicResource OmniSurfaceBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}"/>
                <Button Content="Instagram" Click="QuickChip_Click" Tag="https://www.instagram.com" Height="22" Padding="6,0" Margin="0,0,4,4" FontSize="10" Background="{DynamicResource OmniSurfaceBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}"/>
                <Button Content="HLS .m3u8 Live" Click="QuickChip_Click" Tag="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4" Height="22" Padding="6,0" Margin="0,0,4,4" FontSize="10" Background="{DynamicResource OmniSurfaceBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}"/>
                <Button Content="Direct MP4" Click="QuickChip_Click" Tag="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/TearsOfSteel.mp4" Height="22" Padding="6,0" Margin="0,0,4,4" FontSize="10" Background="{DynamicResource OmniSurfaceBrush}" Foreground="{DynamicResource OmniForegroundBrush}" BorderBrush="{DynamicResource OmniBorderBrush}"/>
            </WrapPanel>
        </StackPanel>

        <!-- Format & Destination Directory -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Quality / Format -->
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Format / Quality:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,0,0,6"/>
                <ComboBox x:Name="CmbFormat" Height="36" FontSize="12" VerticalContentAlignment="Center"
                          Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}"
                          BorderBrush="{DynamicResource OmniBorderBrush}">
                    <ComboBoxItem Content="Best Quality (MP4 Video + Audio)" IsSelected="True"/>
                    <ComboBoxItem Content="High Definition 1080p"/>
                    <ComboBoxItem Content="Standard 720p"/>
                    <ComboBoxItem Content="Audio Only (MP3 320kbps)"/>
                </ComboBox>
            </StackPanel>

            <!-- Output Folder -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Save Destination Folder:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource OmniForegroundBrush}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtOutputFolder" Height="36" FontSize="12" Padding="10,8" VerticalContentAlignment="Center"
                             Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}"
                             BorderBrush="{DynamicResource OmniBorderBrush}"/>

                    <Button Grid.Column="1" Content="📁 Browse..." Click="BtnBrowseFolder_Click"
                            Height="36" Padding="12,0" Margin="8,0,0,0"
                            Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}"
                            BorderBrush="{DynamicResource OmniBorderBrush}"/>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Action Controls -->
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtStatus" Text="Ready to download. Enter a stream or video link above."
                       FontSize="12" Foreground="{DynamicResource OmniMutedForegroundBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnCancel" Content="⏹ Cancel" Click="BtnCancel_Click" IsEnabled="False"
                        Width="90" Height="34" Margin="0,0,10,0"
                        Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}"
                        BorderBrush="{DynamicResource OmniBorderBrush}"/>

                <Button x:Name="BtnDownload" Content="⬇ Start Download" Click="BtnDownload_Click"
                        Width="150" Height="34" FontWeight="Bold"
                        Background="{DynamicResource OmniAccentBrush}" Foreground="#FFFFFF" BorderThickness="0"/>
            </StackPanel>
        </Grid>

        <!-- Progress HUD -->
        <Border Grid.Row="4" Background="{DynamicResource OmniSurfaceBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <TextBlock x:Name="TxtProgressPercent" Text="Progress: 0%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OmniForegroundBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtSpeed" Text="Speed: 0.0 MB/s" FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,0,14,0"/>
                        <TextBlock x:Name="TxtSize" Text="Size: 0 MB / 0 MB" FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,0,14,0"/>
                        <TextBlock x:Name="TxtEta" Text="ETA: --:--" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OmniAccentBrush}"/>
                    </StackPanel>
                </Grid>

                <ProgressBar x:Name="PrgDownload" Height="10" Minimum="0" Maximum="100" Value="0"
                             Foreground="{DynamicResource OmniAccentBrush}" Background="{DynamicResource OmniControlBackgroundBrush}" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- Completed Downloads List -->
        <Border Grid.Row="5" Background="{DynamicResource OmniSurfaceBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✅ Completed Downloads" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource OmniForegroundBrush}"/>
                        <TextBlock x:Name="TxtCompletedCount" Text=" (0)" FontSize="12" Foreground="{DynamicResource OmniMutedForegroundBrush}"/>
                    </StackPanel>
                    <Button Content="Clear History" Click="BtnClearHistory_Click" HorizontalAlignment="Right"
                            Height="24" Padding="8,0" FontSize="11"
                            Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}"
                            BorderBrush="{DynamicResource OmniBorderBrush}"/>
                </Grid>

                <ListBox Grid.Row="1" x:Name="LstCompleted" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,3"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource OmniHeaderBrush}" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                        <ColumnDefinition Width="*"/>    <!-- Name & Details -->
                                        <ColumnDefinition Width="Auto"/> <!-- Actions -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Media Icon -->
                                    <Border Grid.Column="0" Width="36" Height="36" Background="{DynamicResource OmniSurfaceBrush}" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="🎬" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OmniForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Button Content="▶ Play in PSD Player" Click="BtnPlayItem_Click" Tag="{Binding}"
                                                Height="28" Padding="10,0" Margin="0,0,6,0" FontWeight="SemiBold"
                                                Background="{DynamicResource OmniAccentBrush}" Foreground="#FFFFFF" BorderThickness="0"/>
                                        <Button Content="📂 Open Folder" Click="BtnOpenFolderItem_Click" Tag="{Binding}"
                                                Height="28" Padding="10,0"
                                                Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}"
                                                BorderBrush="{DynamicResource OmniBorderBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="TxtEmptyCompleted" Grid.Row="1" Text="No completed downloads in this session."
                           FontSize="12" Foreground="{DynamicResource OmniMutedForegroundBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="6" Margin="0,12,0,0">
            <TextBlock Text="PSD Media Player Studio Suite • Universal Media Engine"
                       FontSize="11" Foreground="{DynamicResource OmniMutedForegroundBrush}" VerticalAlignment="Center"/>
            <Button Content="Close" Click="BtnClose_Click" Width="80" Height="30" HorizontalAlignment="Right"
                    Background="{DynamicResource OmniControlBackgroundBrush}" Foreground="{DynamicResource OmniForegroundBrush}"
                    BorderBrush="{DynamicResource OmniBorderBrush}"/>
        </Grid>
    </Grid>
</Window>
